<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="14.3" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{1139CF27-F48D-4B45-992F-0AD8EC1C1ADB}</ProjectGuid>
    <ProjectName>PyDms</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
  </PropertyGroup>
  <PropertyGroup>
    <_ProjectFileVersion>10.0.21006.1</_ProjectFileVersion>
    <!-- A CPython extension consumes the interpreter's already-loaded runtime.
         In particular, vcpkg applocal must not copy its python312.dll when it
         scans the cp312 target; the setup intentionally ships no Python DLL. -->
    <VcpkgApplocalDeps>false</VcpkgApplocalDeps>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- Set after Cpp.props so its DynamicLibrary default (.dll) does not override .pyd;
       otherwise $(TargetExt) stays .dll and mismatches the linker OutputFile (MSB8012). -->
  <PropertyGroup>
    <TargetExt>.pyd</TargetExt>
    <!-- Use Python's normal SOABI filename. A different CPython minor will then
         ignore this module instead of trying to load an incompatible DLL. -->
    <GeoDmsPythonPlatformTag Condition="'$(Platform)'=='x64'">win_amd64</GeoDmsPythonPlatformTag>
    <GeoDmsPythonPlatformTag Condition="'$(Platform)'=='Win32'">win32</GeoDmsPythonPlatformTag>
    <TargetName>geodms.cp$(GeoDmsPythonAbi)-$(GeoDmsPythonPlatformTag)</TargetName>
  </PropertyGroup>
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>
  <ImportGroup Condition="'$(Configuration)'=='Debug'" Label="PropertySheets">
    <Import Project="..\..\DmsDebug.props" />
  </ImportGroup>
  <ImportGroup Condition="'$(Configuration)'=='Release'" Label="PropertySheets">
    <Import Project="..\..\DmsRelease.props" />
  </ImportGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(GeoDmsPythonIncludeDir);./src;../../rtc/dll/src/sym;../../rtc/dll/src/tic;../../rtc/dll/src;../../geo/dll/src;../../clc/dll/include;../../stx/dll/src;../../shv/dll/src;../../stg/dll/src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_CONSOLE;GEODMS_PYTHON_MAJOR=$(GeoDmsPythonMajor);GEODMS_PYTHON_MINOR=$(GeoDmsPythonMinor);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <OutputFile>$(OutDir)$(TargetName)$(TargetExt)</OutputFile>
      <!-- Never use *.lib here: the CPython install also contains python3.lib,
           which made the module import both python3.dll and python313.dll. -->
      <AdditionalDependencies>$(GeoDmsPythonLibraries)/python$(GeoDmsPythonAbi).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='Win32'">
    <Link>
      <TargetMachine>MachineX86</TargetMachine>
      <OutputFile>$(OutDir)$(TargetName).pyd</OutputFile>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\Bindings.cpp" />
  </ItemGroup>
  <Target Name="DmsValidatePythonAbi" BeforeTargets="ClCompile;Link">
    <Error Condition="'$(GeoDmsPythonVersion)' == ''"
           Text="GeoDMS Python versions are missing from python\PythonVersions.txt." />
    <Error Condition="'$(GeoDmsPythonIncludeDir)' == '' or !Exists('$(GeoDmsPythonIncludeDir)\Python.h')"
           Text="CPython $(GeoDmsPythonVersion) headers not found. Set PYTHON$(GeoDmsPythonAbi)_ROOT or PYTHON$(GeoDmsPythonAbi)_INCLUDE_DIR." />
    <Error Condition="'$(GeoDmsPythonLibraries)' == '' or !Exists('$(GeoDmsPythonLibraries)\python$(GeoDmsPythonAbi).lib')"
           Text="CPython $(GeoDmsPythonVersion) import library not found. Set PYTHON$(GeoDmsPythonAbi)_ROOT or PYTHON$(GeoDmsPythonAbi)_LIBRARIES." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\..\clc\dll\Clc.vcxproj">
      <Project>{41dd88b1-2f24-45aa-9cbb-4318f97bbc22}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\geo\dll\GeoDLL.vcxproj">
      <Project>{c0c75a4b-dd01-4272-8fb5-3a242da125ba}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\rtc\dll\DmRtc.vcxproj">
      <Project>{f1f7b558-ce16-4452-a876-eadb679a4463}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\stg\dll\StgDll.vcxproj">
      <Project>{f77fad2b-615a-47d7-ae87-a6f996d63c12}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\stx\dll\StxDll.vcxproj">
      <Project>{df25d3ca-dd28-4f0d-870a-09b12eadcb2e}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Build every non-default ABI as a second project instance. The outer
       instance (currently cp314) has already built all project references;
       each child gets its own IntDir and writes its tagged .pyd beside it. -->
  <Target Name="DmsBuildAdditionalPythonAbis"
          AfterTargets="Build"
          Condition="'$(DmsPythonMatrixChild)' != 'true' and '$(Platform)' == 'x64'">
    <ItemGroup>
      <!-- Unescape before Include: GeoDmsPythonVersions comes from a property function
           ([System.IO.File]::ReadAllText), and MSBuild ESCAPES a property function's
           result, so its ';' arrives here as %3B. Without the unescape the Include
           yields ONE item literally named "3.12;3.13;3.14": the tasks below do not batch,
           the child build is handed that whole string as GeoDmsPythonVersion, and
           Directory.Build.props dies on [System.Version]::Parse. Only the default ABI
           would ever be built. Invisible on the G flavour, whose PythonVersionsGlobio.txt
           holds a single version and therefore never enters this recursion. -->
      <_DmsPythonMatrixVersion Include="$([MSBuild]::Unescape('$(GeoDmsPythonVersions)'))" />
    </ItemGroup>
    <Message Importance="high"
             Condition="'%(_DmsPythonMatrixVersion.Identity)' != '$(GeoDmsPythonVersion)'"
             Text="Building geodms for CPython %(_DmsPythonMatrixVersion.Identity)..." />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             BuildInParallel="false"
             Condition="'%(_DmsPythonMatrixVersion.Identity)' != '$(GeoDmsPythonVersion)'"
             Properties="Configuration=$(Configuration);Platform=$(Platform);GeoDmsPythonVersion=%(_DmsPythonMatrixVersion.Identity);DmsPythonMatrixChild=true;BuildProjectReferences=false;IntDir=$(DmsIntermediateRoot)\$(Configuration)\$(Platform)\PyDms.cp%(_DmsPythonMatrixVersion.Identity)\" />
  </Target>
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
