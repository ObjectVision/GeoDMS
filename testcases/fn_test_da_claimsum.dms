container fn_test_da_claimsum
{
	// Issue #1196: the claim aggregate per region is summed over the land use types, so the
	// common "no limit" idiom -- a maximum claim that stands for "as many as you like" -- makes
	// each term as large as the claim type allows. Two types at 2^31 sum to exactly 2^32, which
	// in UInt32 is ZERO: the feasibility test then read "there are 4 cells that should be
	// allocated while the total of the maximum claims is only 0" and rejected a problem that is
	// trivially feasible. The sum is now formed in SizeT and clamped to the land unit count,
	// which is what an unbounded maximum means -- no region can absorb more cells than exist.
	unit<uint8>  LuType : nrofrows = 2 { attribute<string> name : ['LuA','LuB']; }
	unit<uint32> CellDom  : nrofrows = 4;
	container Suit
	{
		attribute<int32> LuA (CellDom) : [4,3,2,1];
		attribute<int32> LuB (CellDom) : [1,2,3,4];
	}
	container CMin { parameter<uint32> LuA := 0; parameter<uint32> LuB := 0; }
	container CMax { parameter<uint32> LuA := 2147483648; parameter<uint32> LuB := 2147483648; }
	parameter<int32> thr := 0i;

	container alloc := discrete_alloc_np(LuType/name, CellDom, Suit, CMin, CMax, thr);

	container checks
	{
		parameter<uint32> feasible := uint32(alloc/statusFlag)
		,	IntegrityCheck = "feasible == 1";

		parameter<uint32> allocated := alloc/total_allocated/LuA + alloc/total_allocated/LuB
		,	IntegrityCheck = "allocated == 4";
	}
}
