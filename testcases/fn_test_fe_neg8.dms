container fn_test_fe_neg8
{
	// §12.7 for_each typed result container — the DOMAIN half, under forall.
	// The pseudo-expanded member 'm1' takes its domain from the for_each domain
	// argument, which here is the FORMAL unit parameter 'dom' (the K2 bridge:
	// the member's type rides that formal's unifier node). Declaring the member
	// over a DIFFERENT formal 'other' is therefore a rigid-rigid conflict at the
	// DEFINITION — it holds for every instantiation, and no for_each is expanded.
	// (fn_test_fe_neg4 pins the VALUES-class half; fn_test_fe_neg1 the member set.)
	unit<uint32> D : nrofrows = 3;
	unit<uint32> E : nrofrows = 5;
	attribute<float64> src (D) : [1.0, 2.0, 3.0];

	unit<uint32> NSet : nrofrows = 2;
	attribute<string> mnames (NSet) : ['m1','m2'];
	attribute<string> mexprs (NSet) : ['src + 1.0','src + 2.0'];

	function f_formal(unit<uint32> dom; unit<uint32> other) -> parameter<float64>
	{
		container fe := for_each_nedv(mnames, mexprs, dom, float64);
		attribute<float64> bad (other) := fe/m1;
		parameter<float64> result := sum(bad);
	}
	parameter<float64> p := f_formal(D, E);

	container checks { parameter<float64> c := p, IntegrityCheck = "c == 9.0"; }
}
