container fn_test_odmembers
{
	// §12.8/slSubItemCall + dijkstra OD member emissions: an OD impedance_matrix
	// in a function body is CACHEABLE, so od/impedance, od/OrgZone_rel,
	// od/DstZone_rel all inline-reduce (via slSubItemCall) AND type at
	// definition — impedance over the fresh OD_Pairs unit (float64 from the
	// link impedance), the zone-rels over it with values riding the start/end
	// zone units. Minimal OD network: 2 nodes, 1 directed link 0->1, imp 1.0;
	// one start point (node 0), one end point (node 1) => 1 OD pair.
	unit<uint32> Node : nrofrows = 2;
	unit<uint32> Link : nrofrows = 1
	{
		attribute<Node>    N1_rel  : [0];
		attribute<Node>    N2_rel  : [1];
		attribute<float64> imp : [1.0];
	}
	unit<uint32> StartSet : nrofrows = 1 { attribute<Node> nr : [0]; }
	unit<uint32> EndSet   : nrofrows = 1 { attribute<Node> nr : [1]; }

	function odsum(attribute<float64> w (Link); attribute<Node> fromNd (Link); attribute<Node> toNd (Link); attribute<Node> sr (StartSet); attribute<Node> er (EndSet))
	-> parameter<float64>
	{
		unit<uint32> od := impedance_matrix('directed;startPoint(Node_rel);endPoint(Node_rel);od:impedance,OrgZone_rel,DstZone_rel', w, fromNd, toNd, sr, er);
		parameter<float64> result :=
			  sum(od/impedance)                    // float64 impedances over OD pairs
			+ sum(float64(od/OrgZone_rel))         // start-zone rel (values over StartSet)
			+ sum(float64(od/DstZone_rel));        // dst-zone rel (values over EndSet)
	}
	parameter<float64> s := odsum(Link/imp, Link/N1_rel, Link/N2_rel, StartSet/nr, EndSet/nr);

	container checks
	{
		// 1 OD pair: impedance 1.0, OrgZone_rel [0], DstZone_rel [0] => 1.0
		parameter<float64> c_1 := s, IntegrityCheck = "c_1 == 1.0";
	}
}
