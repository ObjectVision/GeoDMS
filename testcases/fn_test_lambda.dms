container fn_test_lambda
{
	// §5.11 tier B: function literals in parenthesized expression positions,
	// lifted at parse time into hidden '_lambda_<n>' declarations.
	unit<uint32> Road : nrofrows = 3 { attribute<float64> flow : [ 1.0, 2.0, 3.0 ]; }

	nuf = function<Vx: numerics, Dx: domains>(attribute<Vx> (Dx)) -> attribute<Vx> (Dx);

	function compose<Vx: numerics, Dx: domains>(f: nuf<Vx, Dx>; g: nuf<Vx, Dx>) -> nuf<Vx, Dx>
		:= function(attribute<Vx> x (Dx)) -> attribute<Vx> (Dx) := f(g(x));

	// B1: a GENERIC literal as an argument (its own <W, E> clause; extent ends at ',')
	attribute<float64> a (Road)
		:= compose(function<Wx: numerics, E: domains>(attribute<Wx> y (E)) -> attribute<Wx> (E) := y + 1.0, sqr)(Road/flow);
	// f=literal, g=sqr: x^2 + 1 -> [2, 5, 10]

	// B2: a parenthesized literal, immediately applied (splice swallows the parens)
	attribute<float64> b (Road)
		:= (function(attribute<float64> z (Road)) -> attribute<float64> (Road) := 3.0 * z)(Road/flow);
	// [3, 6, 9]

	// B3: a literal inside a function's result expression — hoisted as a body item;
	// its declared domain (D) is the ENCLOSING function's domain variable (lexical)
	function scale2<Dx: domains>(attribute<float64> x (Dx)) -> attribute<float64> (Dx)
		:= (function(attribute<float64> w (Dx)) -> attribute<float64> (Dx) := 2.0 * w)(x);
	attribute<float64> c (Road) := scale2(Road/flow); // [2, 4, 6]

	container checks
	{
		parameter<float64> c_a := sum(a), IntegrityCheck = "c_a == 17.0";
		parameter<float64> c_b := sum(b), IntegrityCheck = "c_b == 18.0";
		parameter<float64> c_c := sum(c), IntegrityCheck = "c_c == 12.0";
	}
}
