container fn_probe_cfgbase_neg
{
	// Config-alias member access, NEGATIVE: a genuinely MISSING member below a
	// config-alias must still fail cleanly with a FindSubItem error, never silently
	// pass. Guards that the direct config-item resolution does not swallow real misses.
	unit<uint32> Dx : nrofrows = 3;
	container cfg { attribute<float64> sub (Dx) : [1.0, 2.0, 3.0]; }

	function f(item it) -> parameter<float64>
	{
		container c := it;
		parameter<float64> result := sum(c/nonexistent); // 'nonexistent' is not a member of cfg
	}
	parameter<float64> y := f(cfg);

	container checks { parameter<float64> c_1 := y; }
}
