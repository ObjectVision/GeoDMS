container fn_test_containerparam_neg1
{
	// K11a-4 negatives, two independent boundary violations across two calls:
	// (a) the argument's nested container lacks the declared member 'offset'
	//     (recursive presence check: "member 'offset' is missing");
	// (b) the argument's factor is a parameter<string> where the declaration
	//     requires float64 ("must be an attribute<float64>").
	unit<uint32> Road : nrofrows = 3 { attribute<float64> flow : [ 1.0, 2.0, 3.0 ]; }

	container BadNested
	{
		parameter<float64> factor := 2.0;
		container nested { parameter<float64> wrong_name := 5.0; }
	}

	function scale( container cfg { parameter<float64> factor; container nested { parameter<float64> offset; } };
	                attribute<float64> x (Road) )
	-> attribute<float64> (Road) := x * cfg/factor + cfg/nested/offset;

	attribute<float64> t1 (Road) := scale(BadNested, Road/flow);

	container BadClass { parameter<string> factor := 'two'; }

	function scale2( container cfg { parameter<float64> factor; }; attribute<float64> x (Road) )
	-> attribute<float64> (Road) := x * cfg/factor;

	attribute<float64> t2 (Road) := scale2(BadClass, Road/flow);

	container checks
	{
		parameter<float64> c1 := sum(t1), IntegrityCheck = "c1 == 27.0";
		parameter<float64> c2 := sum(t2), IntegrityCheck = "c2 == 12.0";
	}
}
