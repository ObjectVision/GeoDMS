container fn_test_gsig
{
	unit<uint32> Road : nrofrows = 3 { attribute<float64> flow : [ 1.0, 2.0, 3.0 ]; }

	nuf = function<Vx: numerics, Dx: domains>(attribute<Vx> (Dx)) -> attribute<Vx> (Dx);

	function inc<Vx: numerics>(attribute<Vx> x) -> attribute<Vx> := x + 1.0;

	// generic signature on a parameter of a closure-producing function
	function twice(h: nuf) -> function
	{
		function result<Vx: numerics>(attribute<Vx> x) -> attribute<Vx> := h(h(x));
	}

	// typed compose: signature with type application on parameters and result
	function compose2<Vx: numerics, Dx: domains>(f: nuf<Vx, Dx>; g: nuf<Vx, Dx>) -> nuf<Vx, Dx>
	{
		function result(attribute<Vx> x (Dx)) -> attribute<Vx> (Dx) := f(g(x));
	}

	attribute<float64> t (Road) := twice(inc)(Road/flow);          // x+2 -> [3,4,5]
	attribute<float64> c (Road) := compose2(inc, inc)(Road/flow);  // x+2 -> [3,4,5]

	container checks
	{
		parameter<float64> c_t := sum(t), IntegrityCheck = "c_t == 12.0";
		parameter<float64> c_c := sum(c), IntegrityCheck = "c_c == 12.0";
	}
}
