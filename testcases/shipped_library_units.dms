// issue #1031, second pass: the setup does not ship only prelude.dms. CopyResources robocopies the
// repo's library and examples folders into bin/<Config>/x64/, and nsi/DmsSetupScript.nsh packages
// both wholesale, with `File ...library\*.*` and `...examples\*.*` wildcards. That is six library
// .dms files and two examples, none of which any test loaded.
//
// This one covers library/Units.dms, by demanding EVERY unit it defines. A unit whose definition
// does not resolve costs nothing until something asks for it, which is how `day := 24 * uur` and
// `MJ_yr := MJ / yr` -- two identifiers that are not defined anywhere in the file -- survived in a
// shipped file. Both are fixed in the same commit as this test; this pins the whole file so the
// next one is caught here rather than in a user's configuration.
container shipped_library_units
{
	#include <%exeDir%/library/Units.dms>

	container checks
	{
		parameter<bool> u_meter     := IsDefined(1.0[units/meter]),     IntegrityCheck = "u_meter == true";
		parameter<bool> u_hm        := IsDefined(1.0[units/hm]),        IntegrityCheck = "u_hm == true";
		parameter<bool> u_km        := IsDefined(1.0[units/km]),        IntegrityCheck = "u_km == true";
		parameter<bool> u_cm        := IsDefined(1.0[units/cm]),        IntegrityCheck = "u_cm == true";
		parameter<bool> u_mm        := IsDefined(1.0[units/mm]),        IntegrityCheck = "u_mm == true";
		parameter<bool> u_meter2    := IsDefined(1.0[units/meter2]),    IntegrityCheck = "u_meter2 == true";
		parameter<bool> u_km2       := IsDefined(1.0[units/km2]),       IntegrityCheck = "u_km2 == true";
		parameter<bool> u_ha        := IsDefined(1.0[units/ha]),        IntegrityCheck = "u_ha == true";
		parameter<bool> u_g         := IsDefined(1.0[units/g]),         IntegrityCheck = "u_g == true";
		parameter<bool> u_kg        := IsDefined(1.0[units/kg]),        IntegrityCheck = "u_kg == true";
		parameter<bool> u_s         := IsDefined(1.0[units/s]),         IntegrityCheck = "u_s == true";
		parameter<bool> u_min       := IsDefined(1.0[units/min]),       IntegrityCheck = "u_min == true";
		parameter<bool> u_hour      := IsDefined(1.0[units/hour]),      IntegrityCheck = "u_hour == true";
		parameter<bool> u_day       := IsDefined(1.0[units/day]),       IntegrityCheck = "u_day == true";
		parameter<bool> u_year      := IsDefined(1.0[units/year]),      IntegrityCheck = "u_year == true";
		parameter<bool> u_month     := IsDefined(1.0[units/month]),     IntegrityCheck = "u_month == true";
		parameter<bool> u_annually  := IsDefined(1.0[units/annually]),  IntegrityCheck = "u_annually == true";
		parameter<bool> u_J         := IsDefined(1.0[units/J]),         IntegrityCheck = "u_J == true";
		parameter<bool> u_kJ        := IsDefined(1.0[units/kJ]),        IntegrityCheck = "u_kJ == true";
		parameter<bool> u_MJ        := IsDefined(1.0[units/MJ]),        IntegrityCheck = "u_MJ == true";
		parameter<bool> u_MJ_yr     := IsDefined(1.0[units/MJ_yr]),     IntegrityCheck = "u_MJ_yr == true";
		parameter<bool> u_GJ        := IsDefined(1.0[units/GJ]),        IntegrityCheck = "u_GJ == true";
		parameter<bool> u_PJ        := IsDefined(1.0[units/PJ]),        IntegrityCheck = "u_PJ == true";
		parameter<bool> u_W         := IsDefined(1.0[units/W]),         IntegrityCheck = "u_W == true";
		parameter<bool> u_kW        := IsDefined(1.0[units/kW]),        IntegrityCheck = "u_kW == true";
		parameter<bool> u_MW        := IsDefined(1.0[units/MW]),        IntegrityCheck = "u_MW == true";
		parameter<bool> u_GW        := IsDefined(1.0[units/GW]),        IntegrityCheck = "u_GW == true";
		parameter<bool> u_TW        := IsDefined(1.0[units/TW]),        IntegrityCheck = "u_TW == true";
		parameter<bool> u_GWh       := IsDefined(1.0[units/GWh]),       IntegrityCheck = "u_GWh == true";
		parameter<bool> u_TWh       := IsDefined(1.0[units/TWh]),       IntegrityCheck = "u_TWh == true";
		parameter<bool> u_MW_km2    := IsDefined(1.0[units/MW_km2]),    IntegrityCheck = "u_MW_km2 == true";
		parameter<bool> u_MW_ha     := IsDefined(1.0[units/MW_ha]),     IntegrityCheck = "u_MW_ha == true";
		parameter<bool> u_ha_ha     := IsDefined(1.0[units/ha_ha]),     IntegrityCheck = "u_ha_ha == true";
		parameter<bool> u_mol       := IsDefined(1.0[units/mol]),       IntegrityCheck = "u_mol == true";
		parameter<bool> u_mol_ha    := IsDefined(1.0[units/mol_ha]),    IntegrityCheck = "u_mol_ha == true";
		parameter<bool> u_mol_ha_yr := IsDefined(1.0[units/mol_ha_yr]), IntegrityCheck = "u_mol_ha_yr == true";
		parameter<bool> u_m_s       := IsDefined(1.0[units/m_s]),       IntegrityCheck = "u_m_s == true";
		parameter<bool> u_km_hr     := IsDefined(1.0[units/km_hr]),     IntegrityCheck = "u_km_hr == true";
		parameter<bool> u_kg_m2     := IsDefined(1.0[units/kg_m2]),     IntegrityCheck = "u_kg_m2 == true";
		parameter<bool> u_K         := IsDefined(1.0[units/K]),         IntegrityCheck = "u_K == true";
		parameter<bool> u_A         := IsDefined(1.0[units/A]),         IntegrityCheck = "u_A == true";
		parameter<bool> u_cd        := IsDefined(1.0[units/cd]),        IntegrityCheck = "u_cd == true";

		// a few metric relations, so the test says more than "it resolves". GetMetricFactor gives
		// the factor towards the base unit; a bare 1.0[km] / 1.0[m] would just be 1.0 / 1.0.
		parameter<bool> r_km    := GetMetricFactor(units/km)     / GetMetricFactor(units/meter)  == 1000.0,  IntegrityCheck = "r_km == true";
		parameter<bool> r_cm    := GetMetricFactor(units/cm)     / GetMetricFactor(units/meter)  == 0.01,    IntegrityCheck = "r_cm == true";
		parameter<bool> r_ha    := GetMetricFactor(units/ha)     / GetMetricFactor(units/meter2) == 10000.0, IntegrityCheck = "r_ha == true";
		parameter<bool> r_km2   := GetMetricFactor(units/km2)    / GetMetricFactor(units/meter2) == 1000000.0, IntegrityCheck = "r_km2 == true";
		parameter<bool> r_day   := GetMetricFactor(units/day)    / GetMetricFactor(units/hour)   == 24.0,    IntegrityCheck = "r_day == true";
		parameter<bool> r_hour  := GetMetricFactor(units/hour)   / GetMetricFactor(units/s)      == 3600.0,  IntegrityCheck = "r_hour == true";
		parameter<bool> r_kg    := GetMetricFactor(units/kg)     / GetMetricFactor(units/g)      == 1000.0,  IntegrityCheck = "r_kg == true";
		parameter<bool> r_pj    := GetMetricFactor(units/PJ)     / GetMetricFactor(units/J)      == 1e15,    IntegrityCheck = "r_pj == true";
		parameter<bool> r_tw    := GetMetricFactor(units/TW)     / GetMetricFactor(units/W)      == 1e12,    IntegrityCheck = "r_tw == true";
		parameter<bool> r_month := abs(GetMetricFactor(units/month) * 12.0 - GetMetricFactor(units/year)) < 1e-9, IntegrityCheck = "r_month == true";
	}
}
