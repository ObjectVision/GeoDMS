container fn_test_variadic
{
	// '...rest' variadic prelude functions: concat / replace_value / combine_data
	// (retired from RewriteExpr.lsp) + variant dispatch on body-nested calls.
	unit<uint32> D : nrofrows = 3
	{
		attribute<string>  sa := 'a' + string(id(D));
		attribute<string>  sb := 'b' + string(id(D));
		attribute<float64> x  := float64(id(D));
	}
	parameter<string> p := 'P';
	parameter<string> q := 'Q';
	parameter<string> r := 'R';

	// concat: 1..3 args, parameters and attributes
	parameter<string> c1 := concat(p);
	parameter<string> c2 := concat(p, q);
	parameter<string> c3 := concat(p, q, r);
	attribute<string> ca (D) := concat(D/sa, '-', D/sb);

	// replace_value: base + one fold step
	attribute<uint32> rv1 (D) := replace_value(id(D), 1, 10);
	attribute<uint32> rv2 (D) := replace_value(id(D), 1, 10, 2, 20);

	// combine_data: base + one fold step
	unit<uint32> u2 : nrofrows = 2;
	unit<uint32> u3 : nrofrows = 3;
	attribute<u2> a2 (D) := value(mod(id(D), 2), u2);
	attribute<u3> a3 (D) := value(mod(id(D), 3), u3);
	unit<uint32> cu  := combine_unit(u2, u3);
	unit<uint32> cu3 := combine_unit(u2, u3, u2);
	attribute<cu>  cd2 (D) := combine_data(cu, a2, a3);
	attribute<cu3> cd3 (D) := combine_data(cu3, a2, a3, a2);

	// a variant set (rescale) called from INSIDE a function body: the nested-call
	// variant-dispatch fix
	function inner(attribute<float64> y) -> attribute<float64> := rescale(y);
	attribute<float64> resc (D) := inner(D/x);

	container checks
	{
		parameter<bool> c_c1 := c1 == 'P',   IntegrityCheck = "c_c1 == true";
		parameter<bool> c_c2 := c2 == 'PQ',  IntegrityCheck = "c_c2 == true";
		parameter<bool> c_c3 := c3 == 'PQR', IntegrityCheck = "c_c3 == true";
		parameter<bool> c_ca := all(ca == D/sa + '-' + D/sb), IntegrityCheck = "c_ca == true";
		parameter<bool> c_r1 := all(rv1 == uint32(id(D) == 1 ? 10 : id(D))), IntegrityCheck = "c_r1 == true";
		parameter<bool> c_r2 := all(rv2 == uint32(id(D) == 1 ? 10 : (id(D) == 2 ? 20 : id(D)))), IntegrityCheck = "c_r2 == true";
		parameter<bool> c_d2 := all(uint32(cd2) == uint32(a2) * uint32(3) + uint32(a3)), IntegrityCheck = "c_d2 == true";
		parameter<bool> c_d3 := all(uint32(cd3) == (uint32(a2) * uint32(3) + uint32(a3)) * uint32(2) + uint32(a2)), IntegrityCheck = "c_d3 == true";
		parameter<bool> c_rs := all(resc == float64(id(D)) / 2.0), IntegrityCheck = "c_rs == true";
	}
}
