container fn_test_unify_neg3
{
	// gen_add is a 2-parameter generic; the signature nuf<V,D> requires a
	// 1-parameter function, so binding it to compose's 'g' is a DEFINITION-time
	// arity mismatch ("gen_add ... has 2 parameter(s); its declared signature
	// '/nuf' requires 1").
	unit<uint32> Road : nrofrows = 3 { attribute<float64> flow : [ 1.0, 2.0, 3.0 ]; }

	nuf = function<Vx: numerics, Dx: domains>(attribute<Vx> (Dx)) -> attribute<Vx> (Dx);

	function fhalf(attribute<float64> x) -> attribute<float64> := x / 2.0;
	function gen_add<Vx: numerics>(attribute<Vx> x; attribute<Vx> y) -> attribute<Vx> := x + y; // 2 params

	function compose<Vx: numerics, Dx: domains>(f: nuf<Vx, Dx>; g: nuf<Vx, Dx>) -> nuf<Vx, Dx>
	{
		function result(attribute<Vx> x (Dx)) -> attribute<Vx> (Dx) := f(g(x));
	}
	attribute<float64> bad (Road) := compose(fhalf, gen_add)(Road/flow);

	container checks { parameter<float64> use := sum(bad); }
}
