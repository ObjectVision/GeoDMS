// STG-A12: an RGB TIFF, three samples of 8 bits, read through tif into a uint32 colour (data/tif_rgb24.tif, 5 x 3,
// pixel k is (17k, k + 100, 255 - k)); refused as a pixel type without value type before 20.24.0
container stor_tif_rgb24
{
	unit<spoint> dom := range(spoint, point_yx(0s, 0s), point_yx(3s, 5s));
	attribute<uint32> img (dom): StorageName = "%currDir%/data/tif_rgb24.tif", StorageType = "tif";
	container checks
	{
		attribute<uint32> k        (dom) := uint32(pointrow(id(dom))) * 5 + uint32(pointcol(id(dom)));
		attribute<uint32> expected (dom) := 17 * k + (k + 100) * 256 + (255 - k) * 65536;
		parameter<uint32> nrWrong := sum(uint32(img != expected)), IntegrityCheck = "nrWrong == 0";
	}
}
