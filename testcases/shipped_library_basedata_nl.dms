// issue #1031, second pass: coverage for the shipped library/basedata_nl files.
//
// grids.dms includes rdc.dms, which in turn includes rdc/ngr_layer.dms, so one config reaches
// three of the six shipped library files. None of them reads any source data -- they are
// coordinate-system, grid-domain and WMTS-layer *definitions* -- so all of it is checkable here.
//
// RegioIndelingen.dms is included too, but only its year table, the instantiation of every year's
// template and one string parameter of it are demanded: everything below that reads -- and,
// failing that, curl-downloads -- %SourceDataDir%/RegionalUnits/cbs/gebiedsindelingen<year>.gpkg,
// which a test must not set off. Note it depends on rdc_meter without including rdc.dms itself, so
// it only resolves when something else pulled that in first, as here.
//
// Units.dms is included as well, in the order examples/grid_to_polygon.dms includes them: the
// per-cell area parameters of grids.dms are declared in units/meter2, units/ha and units/km2.
// They used to name bare meter2, ha and km2, which resolved nowhere, and nothing demanded them
// until the cell-area checks below (GeoDMS-Test #24).
container shipped_library_basedata_nl
{
	#include <%exeDir%/library/Units.dms>
	#include <%exeDir%/library/basedata_nl/grids.dms>
	#include <%exeDir%/library/basedata_nl/RegioIndelingen.dms>

	// ---------------------------------------------------------------- rdc.dms
	// rdc_meter is the RD extent of the Netherlands: x 0..280000, y 300000..625000.
	parameter<float64> rdc_x_min := pointcol(LowerBound(rdc_meter));
	parameter<float64> rdc_x_max := pointcol(UpperBound(rdc_meter));
	parameter<float64> rdc_y_min := pointrow(LowerBound(rdc_meter));
	parameter<float64> rdc_y_max := pointrow(UpperBound(rdc_meter));

	// rdc_mm is that same extent gridded at 1 mm, so it counts 1000 cells per metre per axis
	parameter<int32> mm_cols := pointcol(UpperBound(rdc_mm)) - pointcol(LowerBound(rdc_mm));
	parameter<int32> mm_rows := pointrow(UpperBound(rdc_mm)) - pointrow(LowerBound(rdc_mm));

	// ---------------------------------------------------------------- grids.dms
	// 280000 x 325000 metres at 10 / 25 / 100 m
	parameter<uint32> n10  := uint32(#grids/rdc_10m);
	parameter<uint32> n25  := uint32(#grids/rdc_25m);
	parameter<uint32> n100 := uint32(#grids/rdc_100m);

	// ---------------------------------------------------------------- rdc/ngr_layer.dms
	// The WMTS tile matrix is a 15 x 8 table of strings, sliced into typed columns by index
	// arithmetic -- exactly the kind of thing that breaks silently. Demand every column.
	parameter<uint32>  tm_rows   := uint32(#ngr_layer/TileMatrix);
	parameter<uint32>  tm_elems  := uint32(#ngr_layer/TileMatrixElems);
	parameter<string>  tm_first  := first(ngr_layer/TileMatrix/name);
	parameter<string>  tm_last   := last(ngr_layer/TileMatrix/name);
	parameter<float64> tm_scale0 := first(ngr_layer/TileMatrix/ScaleDenominator);
	parameter<uint32>  tm_mw_sum := sum(ngr_layer/TileMatrix/MatrixWidth);
	parameter<uint32>  tm_mh_sum := sum(ngr_layer/TileMatrix/MatrixHeight);
	parameter<uint32>  tm_tw_sum := sum(uint32(ngr_layer/TileMatrix/TileWidth));
	parameter<uint32>  tm_th_sum := sum(uint32(ngr_layer/TileMatrix/TileHeight));
	parameter<float64> tm_left0  := first(ngr_layer/TileMatrix/LeftCoord);
	parameter<float64> tm_top0   := first(ngr_layer/TileMatrix/TopCoord);
	parameter<string>  tm_target := ngr_layer/target;

	// the per-cell areas, 100 m2 = 1 ha = 0.01 km2 at 100 m, 625 m2 at 25 m, 100 m2 at 10 m
	parameter<float64> ha_100  := grids/impl/perGridsize/size_100m/domain/NrHaPerCell[float64];
	parameter<float64> km2_100 := grids/impl/perGridsize/size_100m/domain/NrKm2PerCell[float64];
	parameter<float64> ha_25   := grids/impl/perGridsize/size_25m/domain/NrHaPerCell[float64];
	parameter<float64> m2_10   := grids/impl/perGridsize/size_10m/domain/NrMeter2PerCell[float64];

	// ---------------------------------------------------------------- RegioIndelingen.dms
	// The years the CBS Gebiedsindelingen are configured for; no gpkg is touched by this.
	parameter<uint32> nr_years   := uint32(#CBS_Gebiedsindelingen_jaren);
	parameter<string> year_first := first(CBS_Gebiedsindelingen_jaren/name);
	parameter<string> year_last  := last (CBS_Gebiedsindelingen_jaren/name);

	// The for_each_ne instantiates Read_Gebiedsindelingen_gpkg_T once per year, and last refers to
	// the highest one. local_file_path is a string built from %SourceDataDir%; asking for it opens
	// nothing (the gpkg container beside it, which would, is not requested).
	parameter<string> last_jaar := CBS/last/jaar;
	parameter<string> file_2025 := CBS/Y2025/local_file_path;

	container checks
	{
		// rdc.dms
		parameter<bool> c_x_min := rdc_x_min ==      0.0, IntegrityCheck = "c_x_min == true";
		parameter<bool> c_x_max := rdc_x_max == 280000.0, IntegrityCheck = "c_x_max == true";
		parameter<bool> c_y_min := rdc_y_min == 300000.0, IntegrityCheck = "c_y_min == true";
		parameter<bool> c_y_max := rdc_y_max == 625000.0, IntegrityCheck = "c_y_max == true";
		parameter<bool> c_mm_c  := mm_cols == 280000000i, IntegrityCheck = "c_mm_c == true";
		parameter<bool> c_mm_r  := mm_rows == 325000000i, IntegrityCheck = "c_mm_r == true";

		// grids.dms: (280000/g) * (325000/g) cells
		parameter<bool> c_n10   := n10  == 28000u * 32500u, IntegrityCheck = "c_n10 == true";
		parameter<bool> c_n25   := n25  == 11200u * 13000u, IntegrityCheck = "c_n25 == true";
		parameter<bool> c_n100  := n100 ==  2800u *  3250u, IntegrityCheck = "c_n100 == true";

		// ngr_layer.dms
		parameter<bool> c_tm_rows  := tm_rows  == 15u,      IntegrityCheck = "c_tm_rows == true";
		parameter<bool> c_tm_elems := tm_elems == 15u * 8u, IntegrityCheck = "c_tm_elems == true";
		parameter<bool> c_tm_first := tm_first == 'EPSG:28992:0',  IntegrityCheck = "c_tm_first == true";
		parameter<bool> c_tm_last  := tm_last  == 'EPSG:28992:14', IntegrityCheck = "c_tm_last == true";
		parameter<bool> c_tm_scale := tm_scale0 == 12288000.0,     IntegrityCheck = "c_tm_scale == true";
		// levels 0..14 are 2^k x 2^k tiles, so the widths sum to 2^15 - 1
		parameter<bool> c_tm_mw    := tm_mw_sum == 32767u, IntegrityCheck = "c_tm_mw == true";
		parameter<bool> c_tm_mh    := tm_mh_sum == 32767u, IntegrityCheck = "c_tm_mh == true";
		parameter<bool> c_tm_tw    := tm_tw_sum == 15u * 256u, IntegrityCheck = "c_tm_tw == true";
		parameter<bool> c_tm_th    := tm_th_sum == 15u * 256u, IntegrityCheck = "c_tm_th == true";
		parameter<bool> c_tm_left  := tm_left0 == -285401.92,  IntegrityCheck = "c_tm_left == true";
		parameter<bool> c_tm_top   := tm_top0  ==  903402.0,   IntegrityCheck = "c_tm_top == true";
		// the request template keeps the placeholders the WMTS reader substitutes
		parameter<bool> c_target   := strpos(tm_target, '@TM@') >= 0
		                           && strpos(tm_target, '@TR@') >= 0
		                           && strpos(tm_target, '@TC@') >= 0, IntegrityCheck = "c_target == true";

		// grids.dms: the cell areas, in the units of Units.dms
		parameter<bool> c_ha_100   := ha_100 == 1.0,                     IntegrityCheck = "c_ha_100 == true";
		parameter<bool> c_km2_100  := abs(km2_100 - 0.01) < 1e-12,       IntegrityCheck = "c_km2_100 == true";
		parameter<bool> c_ha_25    := ha_25 == 0.0625,                   IntegrityCheck = "c_ha_25 == true";
		parameter<bool> c_m2_10    := m2_10 == 100.0,                    IntegrityCheck = "c_m2_10 == true";

		// RegioIndelingen.dms: range(uint32, 2019, 2027) is Y2019 .. Y2026
		parameter<bool> c_years    := nr_years == 8u,             IntegrityCheck = "c_years == true";
		parameter<bool> c_year_1st := year_first == 'Y2019',      IntegrityCheck = "c_year_1st == true";
		parameter<bool> c_year_lst := year_last  == 'Y2026',      IntegrityCheck = "c_year_lst == true";
		parameter<bool> c_last     := last_jaar == '2026',        IntegrityCheck = "c_last == true";
		parameter<bool> c_file     := substr(file_2025, strlen(file_2025) - 26, 26) == 'gebiedsindelingen2025.gpkg', IntegrityCheck = "c_file == true";
	}
}
