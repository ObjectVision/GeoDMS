// Regression for doc/code-audit-2026-09-27.md GEO-A23: reg_count_uint8 and reg_count_uint16 tested
// for an overflow after incrementing, by comparing with 0, but the count after the largest one is
// the null value (255 for uint8), not 0: exactly 255 cells of one class in one region were stored
// as null without an error, and only a 256th cell was reported. Since 20.22.0 the 255th cell is
// reported as the overflow it is. oper_reg_count_uint8_max.dms is the positive side.
// Expected: an error, so exit nonzero on /checks. The check accepts exactly the old null, so the
// config exits 0 only on a build that still stores it.
container oper_reg_count_uint8_full_neg
{
	unit<uint32> D := range(uint32, 0, 255);
	unit<uint32> R : nrofrows = 1;
	unit<uint8>  C : nrofrows = 1
	{
		attribute<string> label : ['c0'];
	}
	container regios
	{
		attribute<R> A (D) := const(0, D, R);
	}
	attribute<C>      src  (D) := const(0, D, C);
	attribute<string> refs (C) : ['A'];

	container counts := reg_count_uint8(src, C/label, regios, refs);

	container checks
	{
		parameter<bool> stored_null := IsNull(counts/c0[0]), IntegrityCheck = "stored_null == true";
	}
}
