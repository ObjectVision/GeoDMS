container fn_test_unify_neg2
{
	unit<uint32> Road : nrofrows = 3 { attribute<float64> flow : [ 1.0, 2.0, 3.0 ]; }
	unit<uint32> Rail : nrofrows = 2 { attribute<float64> flow : [ 5.0, 6.0 ]; }

	nuf = function<Vx: numerics, Dx: domains>(attribute<Vx> (Dx)) -> attribute<Vx> (Dx);

	// declares a CONCRETE domain: instantiates D := Road through the signature
	function road_only(attribute<float64> x (Road)) -> attribute<float64> (Road) := x + 0.0;

	function mixap<Vx: numerics, Dx: domains>(h: nuf<Vx, Dx>; attribute<Vx> y (Dx))
	-> attribute<Vx> (Dx) := h(y);

	// y's domain binds D := Rail; road_only's declared domain conflicts
	attribute<float64> bad (Rail) := mixap(road_only, Rail/flow);

	container checks { parameter<float64> use := sum(bad); }
}
