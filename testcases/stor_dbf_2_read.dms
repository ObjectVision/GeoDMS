// #587 S2: read half of the dbf round trip written by stor_dbf_1_write.dms: the table unit is read
// as storage_read_table, its columns are members of that read.
container stor_dbf_2_read
{
	unit<uint32> tab
	:	StorageName     = "%LocalDataDir%/GeoDmsTestcases/stor_dbf_rt.dbf"
	,	StorageType     = "dbf"
	,	StorageReadOnly = "True"
	{
		attribute<int32>  a;
		attribute<string> s;
	}
	container checks
	{
		parameter<uint32> n  := #tab,              IntegrityCheck = "n == 3";
		parameter<int32>  sa := sum(tab/a),        IntegrityCheck = "sa == 6i";
		parameter<string> ss := asList(tab/s, ''), IntegrityCheck = "ss == 'xyz'";
	}
}
