// #1282: since 2026-10-05 the first criterion of pareto_optimal_eps takes no epsilon: it only orders, and the first row
// of a group always survives. A call written for the builds before, with an epsilon after the first criterion, is
// refused with "pareto_optimal_eps: argument 3 is a parameter where criterion 2 is expected; the first criterion only
// orders and takes no epsilon: ...". Expected: exit nonzero on /checks.
container fn_test_pareto_eps_neg3
{
	unit<uint32> P : nrofrows = 1;
	unit<uint32> E : nrofrows = 4
	{
		attribute<P>       part  : [0, 0, 0, 0];
		attribute<float64> time  : [1, 2, 3, 4];
		attribute<float64> price : [4, 3, 2, 1];
		attribute<bool>    po    := pareto_optimal_eps(part, time, 0.0, price, 0.01);
	}

	container checks
	{
		parameter<uint32> n := sum(uint32(E/po)), IntegrityCheck = "n > 0";
	}
}
