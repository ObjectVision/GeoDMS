container fn_test_vv_neg3
{
	// NEGATIVE: a bound function using ONE variable W in two signature positions
	// forces the two applied variables EQUAL (A ≡ W ≡ B) — a transitive
	// variable-variable consequence invisible to tranche 1. The float64/int32
	// data arguments then conflict at zip's application.
	// Expected: "inconsistent instantiation of type variable ...:
	//            ... (parameter 'x') vs ... (parameter 'y')"
	unit<uint32> Road : nrofrows = 3
	{
		attribute<float64> flow : [ 1.0, 2.0, 3.0 ];
		attribute<int32>   n    : [ 1, 2, 3 ];
	}

	bif = function<A: numerics, B: numerics, D: domains>(attribute<A> (D); attribute<B> (D)) -> attribute<A> (D);

	function add2<W: numerics, E: domains>(attribute<W> p (E); attribute<W> q (E)) -> attribute<W> (E) := p + q;

	function zip<A: numerics, B: numerics, D: domains>(f: bif<A, B, D>; attribute<A> x (D); attribute<B> y (D)) -> attribute<A> (D)
		:= f(x, y);

	attribute<float64> b (Road) := zip(add2, Road/flow, Road/n); // must FAIL
}
