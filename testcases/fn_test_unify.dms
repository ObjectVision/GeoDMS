container fn_test_unify
{
	unit<uint32> Road : nrofrows = 3 { attribute<float64> flow : [ 1.0, 2.0, 3.0 ]; }

	nuf = function<Vx: numerics, Dx: domains>(attribute<Vx> (Dx)) -> attribute<Vx> (Dx);

	function fhalf(attribute<float64> x) -> attribute<float64> := x / 2.0;    // concrete float64
	function gen_inc<Vx: numerics>(attribute<Vx> x) -> attribute<Vx> := x + 1.0; // fully generic

	// concrete + generic through one V: consistent (fhalf instantiates V := float64)
	function compose<Vx: numerics, Dx: domains>(f: nuf<Vx, Dx>; g: nuf<Vx, Dx>) -> nuf<Vx, Dx>
	{
		function result(attribute<Vx> x (Dx)) -> attribute<Vx> (Dx) := f(g(x));
	}
	attribute<float64> ok (Road) := compose(fhalf, gen_inc)(Road/flow);   // (x+1)/2 -> [1, 1.5, 2]

	// V bound by BOTH a function argument (via the signature) and a data argument
	function mixap<Vx: numerics, Dx: domains>(h: nuf<Vx, Dx>; attribute<Vx> y (Dx))
	-> attribute<Vx> (Dx) := h(y);
	attribute<float64> ok2 (Road) := mixap(fhalf, Road/flow);             // [0.5, 1, 1.5]

	container checks
	{
		parameter<float64> c_ok  := sum(ok),  IntegrityCheck = "c_ok == 4.5";
		parameter<float64> c_ok2 := sum(ok2), IntegrityCheck = "c_ok2 == 3.0";
	}
}
