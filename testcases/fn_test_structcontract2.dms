container fn_test_structcontract2
{
	// K11a-3 on the INSTANTIATE path: the boundary contract check runs before the
	// body is copied (CheckStructuredParamContracts in MetaFuncCurry), so a valid
	// argument instantiates and computes — and a missing member is reported at the
	// boundary (see _neg1), not as a transitive Unknown-identifier in the copy.
	unit<uint32> Net : nrofrows = 3
	{
		unit<uint32> nodeset : nrofrows = 3;
		attribute<nodeset> N1_rel : [ 0, 1, 2 ];
		attribute<nodeset> N2_rel : [ 1, 2, 0 ];
	}

	function f( unit<uint32> nw {
		unit<uint32> nodeset;
		attribute<nodeset> N1_rel;
		attribute<nodeset> N2_rel;
	} ) -> parameter<uint32> := sum(pcount(nw/N1_rel) + pcount(nw/N2_rel));

	container inst := instantiate f(Net);

	container checks { parameter<uint32> c := inst/result, IntegrityCheck = "c == 6"; }
}
