// #1261: a closing tag that carries an attribute must be a reported error, not an MG_CHECK
// assertion; the read stops there, so the item that follows the bad tag is absent
container xml_close_attr_neg
{
	container xmlpart { #include <../data/xml_close_attr.xml> }
	container checks
	{
		parameter<string> after := xmlpart/xca/after, IntegrityCheck = "after == 'ok'";
	}
}
