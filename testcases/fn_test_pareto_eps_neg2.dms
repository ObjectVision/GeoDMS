// #1282: the epsilon of pareto_optimal_eps is relative, so dimensionless. An epsilon with a metric, such as
// 0.4 km for a distance, which the builds until 2026-10-05 read as a bucket width of 400 m and which would
// otherwise pass as 40%, is refused with "pareto_optimal_eps: the epsilon of criterion 2 (argument 5) is
// relative, a dimensionless fraction ... and may not have a metric; ...". Expected: exit nonzero on /checks.
container fn_test_pareto_eps_neg2
{
	unit<float64> km := BaseUnit('km', float64);
	parameter<km> DistanceEpsilon := 0.4[km];

	unit<uint32> P : nrofrows = 1;
	unit<uint32> E : nrofrows = 4
	{
		attribute<P>       part : [0, 0, 0, 0];
		attribute<float64> time : [1, 2, 3, 4];
		attribute<km>      dist : [4, 3, 2, 1];
		attribute<bool>    po   := pareto_optimal_eps(part, time, 0.0, dist, DistanceEpsilon);
	}

	container checks
	{
		parameter<uint32> n := sum(uint32(E/po)), IntegrityCheck = "n > 0";
	}
}
