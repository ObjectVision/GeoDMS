container fn_test_p2_neg2
{
	unit<uint32> Road : nrofrows = 2
	{
		attribute<float64> flow  : [ 1.0, 2.0 ];
		attribute<uint32>  lanes : [ 1, 2 ];
	}

	function Same<V: numerics>(unit<uint32> D; attribute<V> a (D); attribute<V> b (D))
	-> attribute<V> (D) := a + b;

	attribute<float64> failing (Road) := Same(Road, Road/flow, Road/lanes);   // expect: inconsistent instantiation of 'V'
}
