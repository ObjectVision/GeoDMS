container fn_test_dt
{
	// POSITIVE: definition-time typed body walker (WP4.1 tranche 3) — generic
	// bodies whose function-call plumbing is fully well-typed for every
	// instantiation; everything must load, def-check and compute.
	unit<uint32> Road : nrofrows = 3
	{
		attribute<float64> flow : [ 1.0, 2.0, 3.0 ];
		attribute<float64> cap  : [ 2.0, 4.0, 6.0 ];
	}

	nuf = function<Vx: numerics, Dx: domains>(attribute<Vx> (Dx)) -> attribute<Vx> (Dx);

	// note the parentheses: a BARE ':= x' result loses its calculation rule at parse
	// time (pre-existing wart, flagged separately)
	function gid<Wx: numerics, E: domains>(attribute<Wx> x (E)) -> attribute<Wx> (E) := (x);

	// generic callee linked through the data flow: gid's fresh W unifies with A both
	// ways; result type flows back to the declared result
	function pass<Ax: numerics, Dx: domains>(attribute<Ax> x (Dx)) -> attribute<Ax> (Dx) := gid(x);

	// HOF plumbing typed end-to-end: sig-typed params applied in the body; the
	// nested result's V/D are its own rigid variables at ITS definition check
	function compose<Vx: numerics, Dx: domains>(f: nuf<Vx, Dx>; g: nuf<Vx, Dx>) -> nuf<Vx, Dx>
	{
		function result(attribute<Vx> x (Dx)) -> attribute<Vx> (Dx) := f(g(x));
	}

	// applied call result typed through the Func value of a sig-typed result
	function pow4<Vx: numerics, Dx: domains>(attribute<Vx> x (Dx)) -> attribute<Vx> (Dx)
		:= compose(sqr, sqr)(x);

	// dependent domain positions: F's second parameter and result share the unit
	// parameter; calling it with an own unit param + own attribute over it is
	// well-typed for every instantiation
	function Fx(unit<uint32> Rd; attribute<float64> x (Rd)) -> attribute<float64> (Rd) := 2.0 * x;
	function useF(unit<uint32> Ux; attribute<float64> y (Ux)) -> attribute<float64> (Ux) := Fx(Ux, y);

	// conversions keep the domain; the declared result checks against the inferred call type
	function conv<Dx: domains>(attribute<float64> x (Dx)) -> attribute<int32> (Dx) := int32(gid(x));

	attribute<float64> a (Road) := pass(Road/flow);              // [1,2,3]
	attribute<float64> b (Road) := pow4(Road/cap);               // [16,256,1296]
	attribute<float64> c (Road) := useF(Road, Road/flow);        // [2,4,6]
	attribute<int32>   d (Road) := conv(Road/flow);              // [1,2,3]

	container checks
	{
		parameter<float64> c_a := sum(a), IntegrityCheck = "c_a == 6.0";
		parameter<float64> c_b := sum(b), IntegrityCheck = "c_b == 1568.0";
		parameter<float64> c_c := sum(c), IntegrityCheck = "c_c == 12.0";
		parameter<float64> c_d := sum(float64(d)), IntegrityCheck = "c_d == 6.0";
	}
}
