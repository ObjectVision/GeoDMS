// box_connectivity reports boxes that touch, an edge or a corner included (#1291), as its wiki page says: a connection is a pair of
// bounding boxes that overlap or touch. The spatial index yielded a box only when it had an interior in common with the query
// box, so a pair that shares only an edge or a corner was never reported: a grid of unit squares had no pairs at all, and
// connected_parts over it, the partition of a split union, gave one part per square.
//   pairs of Box: (0,1) share an x edge, (2,3) a corner, (4,5) overlap by an area, (6,7) share a y edge, (8,9) have a gap,
//   (10,11) a point box on the right edge of box 10.
//   G: a 10 x 10 grid of unit squares, more than the 16 objects at which the index splits a node, so the centre lines of the
//   nodes fall on box edges: 90 + 90 edge pairs and 2 * 81 corner pairs = 342, in each coordinate type.
// Expected: exit 0 on /checks.
container oper_box_connectivity_touching
{
	unit<uint32> Box: nrofrows = 12
	{
		attribute<float64> x0: [0, 1, 10, 11, 20,   21, 30, 30, 40, 41.5, 50, 51 ];
		attribute<float64> y0: [0, 0,  0,  1,  0,    0,  0,  1,  0,  0,    0,  0.5];
		attribute<float64> x1: [1, 2, 11, 12, 21.5, 22, 31, 31, 41, 42,   51, 51 ];
		attribute<float64> y1: [1, 1,  1,  2,  1,    1,  1,  2,  1,  1,    1,  0.5];
		attribute<dpoint>  lb := point_xy(x0, y0, dpoint);
		attribute<dpoint>  ub := point_xy(x1, y1, dpoint);
	}
	unit<uint32> Pair := box_connectivity(Box/lb, Box/ub);

	unit<uint32> Expected: nrofrows = 5
	{
		attribute<Box> F1: [0, 2, 4, 6, 10];
		attribute<Box> F2: [1, 3, 5, 7, 11];
	}

	unit<uint32> G: nrofrows = 100
	{
		attribute<float64> x   := float64(id(.) % 10);
		attribute<float64> y   := float64(id(.) / 10);
		attribute<dpoint>  lbd := point_xy(x, y, dpoint);
		attribute<dpoint>  ubd := point_xy(x + 1.0, y + 1.0, dpoint);
		attribute<fpoint>  lbf := point_xy(float32(x), float32(y), fpoint);
		attribute<fpoint>  ubf := point_xy(float32(x + 1.0), float32(y + 1.0), fpoint);
		attribute<ipoint>  lbi := point_xy(int32(x), int32(y), ipoint);
		attribute<ipoint>  ubi := point_xy(int32(x + 1.0), int32(y + 1.0), ipoint);
		attribute<spoint>  lbs := point_xy(int16(x), int16(y), spoint);
		attribute<spoint>  ubs := point_xy(int16(x + 1.0), int16(y + 1.0), spoint);
	}
	unit<uint32> GPairD := box_connectivity(G/lbd, G/ubd)
	{
		// every pair lies next to each other, and no pair occurs twice
		attribute<bool>   adjacent := abs(G/x[F1] - G/x[F2]) <= 1.0 && abs(G/y[F1] - G/y[F2]) <= 1.0;
		attribute<uint32> key      := uint32(F1) * 100 + uint32(F2);
		unit<uint32> Keys := unique(key);
	}
	unit<uint32> GPairF := box_connectivity(G/lbf, G/ubf);
	unit<uint32> GPairI := box_connectivity(G/lbi, G/ubi);
	unit<uint32> GPairS := box_connectivity(G/lbs, G/ubs);
	unit<uint32> GParts := connected_parts(GPairD/F1, GPairD/F2);

	container checks
	{
		parameter<bool> count    := #Pair == #Expected, IntegrityCheck = "count == true";
		parameter<bool> pairs    := all(Pair/F1 == union_data(Pair, Expected/F1) && Pair/F2 == union_data(Pair, Expected/F2)), IntegrityCheck = "pairs == true";
		parameter<bool> grid_d   := #GPairD == 342 && all(GPairD/adjacent) && #GPairD/Keys == 342, IntegrityCheck = "grid_d == true";
		parameter<bool> grid_f   := #GPairF == 342, IntegrityCheck = "grid_f == true";
		parameter<bool> grid_i   := #GPairI == 342, IntegrityCheck = "grid_i == true";
		parameter<bool> grid_s   := #GPairS == 342, IntegrityCheck = "grid_s == true";
		parameter<bool> one_part := #GParts == 1, IntegrityCheck = "one_part == true";
	}
}
