container fn_test_fe_neg1
{
	// §12.7 for_each tranche: a CLOSED name array is evaluated at definition
	// scan; a member reference outside the pseudo-expanded set is a
	// DEFINITION-time error naming the generated members ('a, b') — not the
	// late generic miss.
	unit<uint32> Dx : nrofrows = 3;
	unit<uint32> NSet : nrofrows = 2;
	attribute<string> mnames (NSet) : ['a','b'];
	attribute<string> mexprs (NSet) : ['x + x','x - x'];
	attribute<float64> src (Dx) : [1.0, 2.0, 3.0];

	function f(attribute<float64> x (Dx)) -> attribute<float64> (Dx)
	{
		container r := for_each_nedv(mnames, mexprs, Dx, float64);
		attribute<float64> result (Dx) := r/zz; // 'zz' is not generated: definition-time error
	}
	attribute<float64> y (Dx) := f(src);

	container checks
	{
		parameter<float64> c_1 := sum(y), IntegrityCheck = "c_1 == 0.0";
	}
}
