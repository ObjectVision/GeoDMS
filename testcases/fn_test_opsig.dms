container fn_test_opsig
{
	// WP4.1 operator signatures (batch 1) + §5.12 auto-typed bare declarations
	unit<uint32> Road : nrofrows = 3
	{
		attribute<float64> flow : [ 1.0, 2.0, 3.0 ];
		attribute<float64> cap  : [ 2.0, 4.0, 6.0 ];
	}

	// typed operator positions in a generic body: '+' links both args and the
	// result through one implicit signature variable, so the declared types check
	function addup<Vx: numerics, Dx: domains>(attribute<Vx> x (Dx); attribute<Vx> y (Dx)) -> attribute<Vx> (Dx)
		:= x + y;

	// bare body local (auto-typed): 'raw' is inferred V[D] from the mul signature,
	// and min_elem unifies it back with x — fully typed without a declaration
	function scaled<Vx: numerics, Dx: domains>(attribute<Vx> x (Dx); attribute<Vx> y (Dx)) -> attribute<Vx> (Dx)
	{
		raw := x * y;
		attribute<Vx> result (Dx) := min_elem(raw, x);
	}

	// comparisons yield bool over the shared domain
	function isless<Vx: numerics, Dx: domains>(attribute<Vx> x (Dx); attribute<Vx> y (Dx)) -> attribute<bool> (Dx)
		:= x < y;

	// §5.12 untyped result designation: '-> restype { result := ...; }'
	function twiceF<Dx: domains>(attribute<float64> x (Dx)) -> attribute<float64> (Dx)
	{
		result := x + x;
	}

	// §5.12 auto-typed CONFIG items: class and domain derive from the calculation
	// (operator rules; a function-application rule still needs a typed holder)
	a := Road/flow + Road/cap;
	s := mul(a, a);

	attribute<float64> t1 (Road) := addup(Road/flow, Road/cap);   // [3,6,9]
	attribute<float64> t2 (Road) := scaled(Road/flow, Road/cap);  // min(x*y, x) = x -> [1,2,3]
	attribute<bool>    t3 (Road) := isless(Road/flow, Road/cap);  // all true
	attribute<float64> t4 (Road) := twiceF(Road/flow);            // [2,4,6]

	container checks
	{
		parameter<float64> c_1 := sum(t1),           IntegrityCheck = "c_1 == 18.0";
		parameter<float64> c_2 := sum(t2),           IntegrityCheck = "c_2 == 6.0";
		parameter<uint32>  c_3 := sum(uint32(t3)),   IntegrityCheck = "c_3 == 3";
		parameter<float64> c_4 := sum(t4),           IntegrityCheck = "c_4 == 12.0";
		parameter<float64> c_a := sum(a),            IntegrityCheck = "c_a == 18.0";
		parameter<float64> c_s := sum(s),            IntegrityCheck = "c_s == 126.0";
	}
}
