container fn_test_scope
{
	unit<uint32> Road : nrofrows = 2
	{
		attribute<float64> flow : [ 100.0, 200.0 ];
	}

	parameter<float64> outside := 42.0;

	// lexical definition scope (§4.6 revision 2026-07-13): 'outside' is visible from
	// the point of definition, so the body may reference it — no 'using' needed
	function Fx(
		unit<uint32>       Rd;
		attribute<float64> x (Rd))
	-> attribute<float64> (Rd) := x * outside;

	attribute<float64> good (Road) := Fx(Road, Road/flow);

	// An explicitly instantiated function resolves a template in its definition
	// namespace, without inheriting the instantiation site's parent namespace.
	template Square
	{
		parameter<float64> x;
		parameter<float64> result := x * x;
	}
	function Materialize(parameter<float64> x) -> parameter<float64>
	{
		container square_call := Square(x);
		parameter<float64> result := square_call/result;
	}
	container site
	{
		// A same-named call-site template must not capture the body call.
		template Square
		{
			parameter<float64> x;
			parameter<float64> result := x + x;
		}
		container materialized := instantiate /Materialize(3.0);
	}

	container checks
	{
		parameter<float64> check := sum(good), IntegrityCheck = "check == 12600.0"; // 300 * 42
		parameter<float64> check_inst := site/materialized/result, IntegrityCheck = "check_inst == 9.0";
	}
}
