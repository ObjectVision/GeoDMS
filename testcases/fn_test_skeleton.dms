container fn_test_skeleton
{
	// §6.2 cross-record domain skeleton: when several congruence records survive
	// (so no single record's VALUE claims apply), the records may still AGREE on
	// the DOMAIN structure, which holds whichever member reduction selects.
	// Positives: the claim must not equate the positions' VALUE classes.
	unit<uint32> Dx : nrofrows = 3
	{
		attribute<float64> a : [ 1.0, 2.0, 3.0 ];
		attribute<uint32>  n : [ 1, 2, 3 ];
	}

	// 'add' survives as three records (two polygon families + the scalar family)
	// with classless arguments; only the shared domain is claimed.
	function addup(attribute<float64> x (Dx); attribute<float64> y (Dx))
	-> attribute<float64> (Dx) := x + y;
	attribute<float64> s (Dx) := addup(Dx/a, Dx/a);

	// 'iif' likewise: its condition is bool while its branches and result are
	// numeric — the skeleton must keep those value classes INDEPENDENT (a shared
	// fresh variable would make this a bool-vs-uint32 conflict).
	function pick(attribute<uint32> k (Dx)) -> attribute<uint32> (Dx) := (sum(k) >= 0 ? k : 0);
	attribute<uint32> p (Dx) := pick(Dx/n);

	container checks
	{
		parameter<float64> c1 := sum(s), IntegrityCheck = "c1 == 12.0";
		parameter<uint32>  c2 := sum(p), IntegrityCheck = "c2 == 6";
	}
}
