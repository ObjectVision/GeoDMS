container fn_test_structmember_neg2
{
	// K11a-1b: F1 and F2 relate to DIFFERENT node units (ns1, ns2) in the structured
	// parameter's member block. Each member attribute carries its sibling member unit's
	// IDENTITY node (K11a-1b), so pcount(nw/F1) types over ns1 and pcount(nw/F2) over ns2
	// at definition. The body adds them, which requires a shared domain. NOTE: the `+`
	// (add) operator has multi-class/undescribed overloads, so the def-time walker DEFERS
	// it (theRecord<0); the ns1!=ns2 domain conflict is therefore reported at the
	// instantiation (reduction of the concrete argument), not under forall. A def-time
	// forall catch of this needs a DESCRIBED combining operator (add deferral is the gate).
	unit<uint32> Net : nrofrows = 2
	{
		unit<uint32> ns1 : nrofrows = 3;
		unit<uint32> ns2 : nrofrows = 4;
		attribute<ns1> N1_rel : [ 0, 1 ];
		attribute<ns2> N2_rel : [ 0, 2 ];
	}
	function bad_net( unit<uint32> nw {
		unit<uint32> ns1;
		unit<uint32> ns2;
		attribute<ns1> N1_rel;
		attribute<ns2> N2_rel;
	} ) -> parameter<uint32> := sum(pcount(nw/N1_rel) + pcount(nw/N2_rel));

	parameter<uint32> total := bad_net(Net);
	container checks { parameter<uint32> c := total, IntegrityCheck = "c == 5"; }
}
