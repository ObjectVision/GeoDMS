// #587 S2: write half of the dbf round trip: gdalwrite.vect writes a .dbf (ESRI Shapefile driver,
// attributes only); stor_dbf_2_read.dms reads it back through the dbf storage manager. Run item:
// /export (fnrun_itemmap.txt).
container stor_dbf_1_write
{
	unit<uint32> obj : nrofrows = 3
	{
		attribute<int32>  a : [1, 2, 3];
		attribute<string> s : ['x', 'y', 'z'];
	}
	container export
	{
		unit<uint32> tab := obj
		,	StorageName = "%LocalDataDir%/GeoDmsTestcases/stor_dbf_rt.dbf"
		,	StorageType = "gdalwrite.vect"
		{
			attribute<int32>  a := obj/a;
			attribute<string> s := obj/s;
		}
	}
}
