// #917 negative: an unknown kernel variant must be rejected, not silently substituted.
// Expected: nonzero exit (ParseMinkowskiKernelShape throws, listing the accepted spellings).
container oper_minkowski_neg1
{
	unit<uint32> G   : nrofrows = 1;
	unit<uint32> GPt : nrofrows = 4;

	attribute<int32>  gx   (GPt) : [ 0, 0, 100, 100 ];
	attribute<int32>  gy   (GPt) : [ 0, 100, 100, 0 ];
	attribute<G>      gseq (GPt) : [ 0, 0, 0, 0 ];
	attribute<uint32> gord (GPt) : [ 0, 1, 2, 3 ];

	attribute<ipoint> gpt (GPt) := point_xy(gx, gy, ipoint);
	attribute<ipoint> geom (G, polygon) := points2polygon(gpt, gseq, gord);

	container checks
	{
		// '5D' is not one of the six shapes; there is no 5-corner kernel.
		attribute<ipoint> bad (G, polygon) := bp_minkowski_sum(bp_polygon(geom), float64(10), 'i5D');
		parameter<float64> a := sum(area(bad));
		parameter<bool> ok := a > 0.0, IntegrityCheck = "ok == True";
	}
}
