container fn_test_domvar_neg
{
	unit<uint32> Road : nrofrows = 3 { attribute<float64> flow : [ 1.0, 2.0, 3.0 ]; }
	unit<uint32> Rail : nrofrows = 2 { attribute<float64> flow : [ 5.0, 6.0 ]; }

	function ratio<Vx: numerics, Dx: domains>(attribute<Vx> a (Dx); attribute<Vx> b (Dx))
	-> attribute<Vx> (Dx) := a / b;

	// Road and Rail domains differ: D cannot be instantiated consistently
	attribute<float64> bad (Road) := ratio(Road/flow, Rail/flow);

	container checks { parameter<float64> use := sum(bad); }
}
