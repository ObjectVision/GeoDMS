container fn_test_vv4
{
	// REGRESSION (tranche 2 defect, fixed in tranche 3): the SAME generic function
	// bound to two DIFFERENT sig-typed parameters must get independent variable
	// instances — binding gid to both f: nuf<A, D> and g: nuf<B, E> must NOT force
	// A ≡ B through gid's shared W. This application (A=float64, B=int32) is valid.
	unit<uint32> Road : nrofrows = 3
	{
		attribute<float64> flow : [ 1.0, 2.0, 3.0 ];
		attribute<int32>   n    : [ 1, 2, 3 ];
	}

	nuf = function<Vx: numerics, Dx: domains>(attribute<Vx> (Dx)) -> attribute<Vx> (Dx);

	function gid<Wx: numerics, E: domains>(attribute<Wx> x (E)) -> attribute<Wx> (E) := x;

	function two<Ax: numerics, Bx: numerics, Dx: domains, E: domains>(
		f: nuf<Ax, Dx>; g: nuf<Bx, E>;
		attribute<Ax> x (Dx); attribute<Bx> y (E))
	-> attribute<Ax> (Dx)
		:= f(x);

	attribute<float64> a (Road) := two(gid, gid, Road/flow, Road/n);

	container checks
	{
		parameter<float64> c_a := sum(a), IntegrityCheck = "c_a == 6.0";
	}
}
