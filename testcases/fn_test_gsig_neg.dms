container fn_test_gsig_neg
{
	unit<uint32> Road : nrofrows = 2 { attribute<float64> flow : [ 1.0, 2.0 ]; }

	nuf = function<Vx: numerics, Dx: domains>(attribute<Vx> (Dx)) -> attribute<Vx> (Dx);

	// a binary function cannot bind to a unary signature
	function add2<Vx: numerics>(attribute<Vx> a; attribute<Vx> b) -> attribute<Vx> := a + b;

	function twice(h: nuf) -> function
	{
		function result<Vx: numerics>(attribute<Vx> x) -> attribute<Vx> := h(h(x));
	}

	attribute<float64> bad (Road) := twice(add2)(Road/flow);

	container checks { parameter<float64> use := sum(bad); }
}
