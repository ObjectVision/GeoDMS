// #1261: a closing tag whose name does not match the open tag must be a reported error, not an
// MG_CHECK assertion; the read stops there, so the item that follows the bad tag is absent
container xml_close_mismatch_neg
{
	container xmlpart { #include <../data/xml_close_mismatch.xml> }
	container checks
	{
		parameter<string> after := xmlpart/xcm/after, IntegrityCheck = "after == 'ok'";
	}
}
