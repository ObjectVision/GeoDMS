// Regression for doc/code-audit-2026-09-27.md GEO-A11: with given ordinals, points2sequence placed
// each point at its ordinal without noticing a duplicate, which left another slot of the sequence
// unwritten and uninitialised. A duplicate ordinal is now an error.
// Expected: exit nonzero on /checks (orderNr 0 occurs more than once in sequence 0).
container oper_points2sequence_dup_ord_neg
{
	unit<uint32> Seq: nrofrows = 1;
	unit<uint32> Pt: nrofrows = 3
	{
		attribute<float64> x: [0, 1, 2];
		attribute<dpoint>  point := point_xy(x, x, dpoint);
		attribute<Seq>     seq: [0, 0, 0];
		attribute<uint32>  ord: [0, 0, 2];
	}
	attribute<dpoint> lines (Seq, arc) := points2sequence(Pt/point, Pt/seq, Pt/ord);

	container checks
	{
		parameter<uint32> n := sum(sequence_element_count(lines)), IntegrityCheck = "n == 3";
	}
}
