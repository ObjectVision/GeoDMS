container fn_test_applyt_neg
{
	// no 'result' sub-item: 'apply' has no value to take
	template NoResult
	{
		unit<uint32>       D;
		attribute<float64> x (D);
		attribute<float64> outcome (D) := 2.0 * x;
	}

	unit<uint32> Road : nrofrows = 2 { attribute<float64> flow : [ 1.0, 2.0 ]; }

	attribute<float64> bad (Road) := apply NoResult(Road, Road/flow);

	container checks { parameter<float64> use := sum(bad); }
}
