container fn_test_ci_neg1
{
	// connect_info members: the result member set is COMPLETE (dist, arc_rel,
	// ArcID, CutPoint, InArc, InSegm, SegmID), so a reference to a non-member is
	// a DEFINITION-time error listing the produced set, not a late per-application miss.
	unit<uint32> ArcPoints : nrofrows = 2
	{
		attribute<float32> px      := float32(id(.)) * 10f;
		attribute<float32> py      := float32(id(.)) *  0f;
		attribute<fpoint>  point   := point_yx(py, px, fpoint);
		attribute<Arc>     seq_rel : [0, 0];
		attribute<uint32>  ordinal := id(.);
	}
	unit<uint32> Arc : nrofrows = 1
	{
		attribute<fpoint> geometry (Arc) := points2sequence(ArcPoints/point, ArcPoints/seq_rel, ArcPoints/ordinal);
	}
	unit<uint32> Pnt : nrofrows = 1 { attribute<fpoint> geometry := const(point_yx(3f, 5f, fpoint), .); }

	function bad(attribute<fpoint> arcs (Arc); attribute<fpoint> pts (Pnt)) -> parameter<uint32>
	{
		container ci := connect_info(arcs, pts);
		parameter<uint32> result := sum(uint32(ci/nonesuch)); // not a connect_info member
	}
	parameter<uint32> n := bad(Arc/geometry, Pnt/geometry);

	container checks
	{
		parameter<uint32> c_1 := n, IntegrityCheck = "c_1 == 0";
	}
}
