// #1282: the imp2_epsilon of impedance_matrix's pareto option is relative, so dimensionless. An epsilon with a
// metric, such as 0.4 km for a second criterion in km, which the builds until 2026-10-05 read as a bucket width
// of 400 m, is refused with "pareto: imp2_epsilon is relative, a dimensionless fraction ... and may not have a
// metric; ...". Expected: exit nonzero on /checks.
container fn_test_od_pareto_eps_neg2
{
	unit<float64> km := BaseUnit('km', float64);
	parameter<km> DistanceEpsilon := 0.4[km];

	unit<uint32> Node : nrofrows = 3;
	unit<uint32> Link : nrofrows = 2
	{
		attribute<Node>    N1_rel : [0, 1];
		attribute<Node>    N2_rel : [1, 2];
		attribute<float64> t      : [1.0, 1.0];
		attribute<km>      d      : [2.0, 3.0];
	}
	unit<uint32> OrgZone : nrofrows = 1;
	unit<uint32> DstZone : nrofrows = 1;
	unit<uint32> StartSet : nrofrows = 1
	{
		attribute<Node>    node_rel : [0];
		attribute<OrgZone> zone_rel : [0];
	}
	unit<uint32> EndSet : nrofrows = 1
	{
		attribute<Node>    node_rel : [2];
		attribute<DstZone> zone_rel : [0];
	}

	unit<uint32> od := impedance_matrix(
		  'directed;startPoint(Node_rel,OrgZone_rel);endPoint(Node_rel,DstZone_rel)'
		  ';cut(OrgZone_max_imp);alternative(link_imp):alt_imp'
		  ';pareto(imp2_epsilon)'
		  ';od:impedance,OrgZone_rel,DstZone_rel'
		, Link/t, Link/N1_rel, Link/N2_rel
		, StartSet/node_rel, StartSet/zone_rel
		, EndSet/node_rel,   EndSet/zone_rel
		, const(100.0, OrgZone)
		, Link/d
		, DistanceEpsilon
		);

	container checks
	{
		parameter<uint32> n := uint32(#od), IntegrityCheck = "n > 0";
	}
}
