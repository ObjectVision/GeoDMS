// Regression for doc/code-fixes.md GEO-27 (2026-09-05): the circular kernel of diversity tested
// each coordinate against its own chord, an inscribed square that was not monotone along a row,
// and the incremental counting then subtracted cells it had never added, so every result for a
// radius of 4 or more was wrong. On a grid whose 256 cells all carry distinct values, the
// diversity of a cell is the number of grid cells within the disc, which is counted here by
// brute force over all cell pairs. Expected: exit 0 on /checks.
//
// The values unit has an explicit range: diversity counts only values below the cardinality of
// the values unit (as nulls are), and with the default uint8 unit the two highest values of the
// grid, 254 and 255, were ignored, which made the counts around the bottom-right corner short.
container diversity_circle
{
	unit<fpoint> gbase;
	unit<spoint> G := range(gridset(gbase, point_yx(1f, 1f, gbase), point_yx(0f, 0f, gbase), spoint), point_yx(0s, 0s), point_yx(16s, 16s))
	{
		attribute<int16> r := pointrow(id(G));
		attribute<int16> c := pointcol(id(G));
		unit<uint32>     Vals := range(uint32, 0, 300);
		attribute<Vals>  v := value(uint32(r) * 16 + uint32(c), Vals); // 16 x 16 = 256 distinct values, all inside Vals
	}

	attribute<G/Vals> div4 (G) := diversity(G/v, uint16(4), uint16(1));
	attribute<G/Vals> div6 (G) := diversity(G/v, uint16(6), uint16(1));

	unit<uint32> pairs := combine(G, G)
	{
		attribute<int32> dr := int32(G/r[first_rel]) - int32(G/r[second_rel]);
		attribute<int32> dc := int32(G/c[first_rel]) - int32(G/c[second_rel]);
		attribute<int32> d2 := dr * dr + dc * dc;
	}
	unit<uint32> disc4 := select_with_org_rel(pairs/d2 <= 16i) { attribute<G> cell := pairs/first_rel[org_rel]; }
	unit<uint32> disc6 := select_with_org_rel(pairs/d2 <= 36i) { attribute<G> cell := pairs/first_rel[org_rel]; }
	attribute<uint32> bf4 (G) := pcount(disc4/cell);
	attribute<uint32> bf6 (G) := pcount(disc6/cell);

	container checks
	{
		// "ok4 == true", not "ok4": a check expression that is exactly the item's own name is a
		// source reference to the item being built, which the UpdateMetaInfo recursion guard refuses
		parameter<bool> ok4 := all(uint32(div4) == bf4), IntegrityCheck = "ok4 == true";
		parameter<bool> ok6 := all(uint32(div6) == bf6), IntegrityCheck = "ok6 == true";
		parameter<uint32> centre4 := uint32(div4[point_yx(8s, 8s, G)]), IntegrityCheck = "centre4 == 49";  // the disc of radius 4 has 49 cells
		parameter<uint32> centre6 := uint32(div6[point_yx(8s, 8s, G)]), IntegrityCheck = "centre6 == 113"; // and that of radius 6 has 113
	}
}
