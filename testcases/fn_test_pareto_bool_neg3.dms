// #1287: pareto_optimal_eps has an operator for every number of arguments up to 17, so that eight numeric
// criteria fit, but nine bool criteria are ten arguments and are refused with "pareto_optimal_eps: 9 criteria
// given, at most 8 are supported", as pareto_optimal refuses nine criteria. Expected: exit nonzero on /checks.
container fn_test_pareto_bool_neg3
{
	unit<uint32> P : nrofrows = 1;
	unit<uint32> E : nrofrows = 4
	{
		attribute<P>    part : [0, 0, 0, 0];
		attribute<bool> b    : [true, false, false, true];
		attribute<bool> po   := pareto_optimal_eps(part, b, b, b, b, b, b, b, b, b);
	}

	container checks
	{
		parameter<uint32> n := sum(uint32(E/po)), IntegrityCheck = "n > 0";
	}
}
