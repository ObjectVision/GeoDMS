container fn_test_dt_neg3
{
	// NEGATIVE (definition-time): the body's result is concretely float64 (via a
	// conversion), but the declared result type is attribute<V> — pinning the
	// rigid V. The definition must fail at first reference.
	// Expected: "the definition of '/bad': the body requires type variable 'V'
	//            to be Float64 ..."
	unit<uint32> Road : nrofrows = 3
	{
		attribute<float64> flow : [ 1.0, 2.0, 3.0 ];
	}

	function gid<Wx: numerics, E: domains>(attribute<Wx> x (E)) -> attribute<Wx> (E) := (x);

	function bad<Vx: numerics, Dx: domains>(attribute<Vx> x (Dx)) -> attribute<Vx> (Dx) := float64(gid(x));

	attribute<float64> z (Road) := bad(Road/flow); // even the float64 call site must not save the definition

	container checks { parameter<float64> use := sum(z); }
}
