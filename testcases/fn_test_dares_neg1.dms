container fn_test_dares_neg1
{
	// K11b result side, negative: total_allocated/<name> is a parameter<claim_type>
	// (uint32). Declaring it as a string is a DEFINITION-time class conflict — the
	// name-directed member family is expanded from the closed type-name array, so
	// no allocation is reduced to find this out.
	unit<uint8>  LuType : nrofrows = 2 { attribute<string> name : ['LuA','LuB']; }
	unit<uint32> CellDom  : nrofrows = 4;
	container Suit
	{
		attribute<int32> LuA (CellDom) := const(1i, CellDom);
		attribute<int32> LuB (CellDom) := const(1i, CellDom);
	}
	container CMin { parameter<uint32> LuA := 1; parameter<uint32> LuB := 1; }
	container CMax { parameter<uint32> LuA := 4; parameter<uint32> LuB := 4; }
	parameter<int32> thr := 0i;

	function bad(unit<uint32> cells) -> parameter<string>
	{
		container alloc := discrete_alloc_np(LuType/name, cells, Suit, CMin, CMax, thr);
		parameter<string> result := alloc/total_allocated/LuA;   // it is a uint32 count
	}
	parameter<string> n := bad(CellDom);

	container checks { parameter<string> c := n, IntegrityCheck = "c == '4'"; }
}
