container fn_test_od_pareto_linkset_neg1
{
	// pareto with od:LinkSet is admitted since #1325, but link_attr is not: it accumulates over the
	// per-node traceback of the scalar engine, which a front does not have. CheckFlags must still
	// reject alternative(link_imp,link_attr) with pareto, also beside a LinkSet.
	unit<uint32> Node : nrofrows = 2;
	unit<uint32> Link : nrofrows = 1
	{
		attribute<Node>    N1_rel : [0];
		attribute<Node>    N2_rel : [1];
		attribute<float64> imp    : [1.0];
		attribute<float64> c      : [1.0];
		attribute<float64> attr   : [1.0];
	}
	unit<uint32> StartSet : nrofrows = 1 { attribute<Node> nr : [0]; }
	unit<uint32> EndSet   : nrofrows = 1 { attribute<Node> nr : [1]; }

	unit<uint32> od := impedance_matrix(
		  'directed;startPoint(Node_rel);endPoint(Node_rel);cut(OrgZone_max_imp);alternative(link_imp,link_attr):alt_imp,link_attr;pareto;od:impedance,LinkSet'
		, Link/imp, Link/N1_rel, Link/N2_rel
		, StartSet/nr, EndSet/nr
		, const(100.0, StartSet)
		, Link/c, Link/attr
		);

	container checks
	{
		parameter<uint32> nr_rows := uint32(#od), IntegrityCheck = "nr_rows == 1";
	}
}
