	unit<uint32> Region : nrofrows = 2;
	unit<uint32> House  : nrofrows = 3
	{
		attribute<Region>  reg   : [0, 1, 1];
		attribute<float64> price : [1.0, 2.0, 3.0];
	}

	function bad<V: numerics>(attribute<V> x (House); attribute<Region> part (House))
	-> attribute<V> (House) := sum(x, part);

	attribute<float64> z (House) := bad(House/price, House/reg);

	container checks { parameter<float64> use := sum(z); }
