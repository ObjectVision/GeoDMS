container fn_test_p3_neg
{
	nullary = () -> parameter<float64>;

	function Bad(f: nullary)
	-> parameter<float64> := f + 1.0;   // value misuse of a function-valued parameter

	function Unity() -> parameter<float64> := 1.0;

	parameter<float64> misuse := Bad(Unity);   // expect: 'can only be applied or passed on' error
}
