// #1361: a program named without a path is looked for in the folder of the child and then on the
// PATH, on Windows with .exe added: cmd on Windows, sh on Linux, neither of which lies in
// testcases. sh gets its command line with -c. Before #1361 the program was taken relative to the
// folder only, and both calls failed: ErrorCode 2 on Windows, No such file or directory on Linux.
// Expected: exit 0 on /checks.
container oper_exec_ec_path
{
	container checks
	{
		parameter<string> ComSpec   := expand(., '%env:ComSpec%');
		parameter<bool>   isWindows := strcount(ComSpec, 'cmd') > 0;
		parameter<string> Program   := isWindows ? 'cmd' : 'sh';
		parameter<string> CmdLine   := isWindows ? 'cmd /c exit 7' : 'exit 7';
		parameter<uint32> exitcode  := exec_ec(Program, CmdLine, expand(., '%currDir%'));
		parameter<bool>   ran       := exitcode == 7, IntegrityCheck = "ran == true";
	}
}
