container fn_test_selmeta_neg
{
	// §12.9 select-family meta collectors, NEGATIVE: a meta-select
	// (dont_cache_result) in a function BODY cannot inline-reduce. The
	// definition-time checker must DEFER its result typing cleanly (no false
	// definition error), so the failure that surfaces is the HONEST inline
	// reduction rejection ("meta function call is not supported inside
	// function bodies"), proving the checker deferred rather than mis-typing.
	unit<uint32> Dx : nrofrows = 4;
	container attrs
	{
		attribute<float64> population (Dx) : [10.0, 20.0, 30.0, 40.0];
	}

	function usesMeta(attribute<bool> c (Dx)) -> parameter<uint32>
	{
		unit<uint32> s := select_with_attr_by_cond(attrs, c);
		parameter<uint32> result := #s;
	}
	attribute<bool> cond (Dx) : [false, true, true, false];
	parameter<uint32> n := usesMeta(cond);

	container checks
	{
		parameter<uint32> c_1 := n, IntegrityCheck = "c_1 == 2";
	}
}
