container fn_test_partial_neg
{
	unit<uint32> Road : nrofrows = 2
	{
		attribute<float64> flow : [ 1.0, 2.0 ];
	}

	function Add2(unit<uint32> Dx; attribute<float64> a (Dx); attribute<float64> b (Dx))
	-> attribute<float64> (Dx) := a + b;

	// binding a partial application to a data item is an error
	attribute<float64> bad (Road) := Add2(Road, Road/flow, _);
}
