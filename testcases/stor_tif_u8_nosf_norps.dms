// STG-13 + STG-N04: an 8-bit single-strip TIFF without RowsPerStrip and without SampleFormat (data/tif_u8_nosf_norps.tif, 8x4, values 0..31)
container stor_tif_u8_nosf_norps
{
	unit<spoint> dom := range(spoint, point_yx(0s, 0s), point_yx(4s, 8s));
	attribute<uint8> img (dom): StorageName = "%currDir%/data/tif_u8_nosf_norps.tif", StorageType = "tif";
	container checks
	{
		parameter<uint32> s := sum(uint32(img)),            IntegrityCheck = "s == 496";
		parameter<uint32> n := sum(uint32(IsDefined(img))), IntegrityCheck = "n == 32";
	}
}
