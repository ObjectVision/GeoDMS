container fn_test_opsigK13_neg3
{
	// §12.7 honest-error upgrade: a CLOSED, cleanly evaluated but INVALID
	// impedance spec is reported at DEFINITION scan (ParseDijkstraString's own
	// error — the very predicate CreateResult applies first), no longer
	// deferred to every application.
	unit<uint32> Node : nrofrows = 2;
	unit<uint32> Link : nrofrows = 1
	{
		attribute<Node>    N1_rel  : [0];
		attribute<Node>    N2_rel  : [1];
		attribute<float64> imp : [1.0];
	}
	unit<uint32> StartSet : nrofrows = 1 { attribute<Node> nr : [0]; }

	function dist<L: domains, Sx: domains>(attribute<float64> w (L); attribute<Node> fromNd (L); attribute<Node> toNd (L); attribute<Node> sr (Sx))
	-> attribute<float64> (Node) := impedance_table('directed;bogusToken(nonsense)', w, fromNd, toNd, sr);

	attribute<float64> d (Node) := dist(Link/imp, Link/N1_rel, Link/N2_rel, StartSet/nr);

	container checks
	{
		parameter<float64> c_1 := sum(d), IntegrityCheck = "c_1 == 1.0";
	}
}
