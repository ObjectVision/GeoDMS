// #1287: in pareto_optimal_eps a numeric criterion is followed by its epsilon, also when bool criteria come
// first. Here the numeric price is the last argument and is refused with "pareto_optimal_eps: criterion 2
// (argument 3) is numeric and must be followed by its epsilon; ...". Expected: exit nonzero on /checks.
container fn_test_pareto_bool_neg2
{
	unit<uint32> P : nrofrows = 1;
	unit<uint32> E : nrofrows = 4
	{
		attribute<P>       part     : [0, 0, 0, 0];
		attribute<float64> price    : [1, 2, 3, 4];
		attribute<bool>    needsCar : [true, false, false, true];
		attribute<bool>    po       := pareto_optimal_eps(part, needsCar, price);
	}

	container checks
	{
		parameter<uint32> n := sum(uint32(E/po)), IntegrityCheck = "n > 0";
	}
}
