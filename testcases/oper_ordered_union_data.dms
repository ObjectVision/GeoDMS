// issue #1168: ordered_union_data is the variant of union_data with which the modeller states that
// all values of all unioned attributes are non-decreasing: monotone increasing, but NOT strictly, so
// equal successive values are allowed, also across the boundary of two arguments.
// CalcResult verifies that statement; this config covers the accepted cases, the oper_ordered_union_data_neg*
// configs cover the rejected ones.
container oper_ordered_union_data
{
	unit<uint32> Ax : nrofrows = 3
	{
		attribute<uint32>  v : [   1,   2,   3 ];
		attribute<float32> f : [ 1.0, 1.0, 2.5 ]; // an equal pair within one argument
	}

	unit<uint32> Bx : nrofrows = 2
	{
		attribute<uint32>  v : [   3,   7 ]; // opens with the last value of A/v: equal is allowed
		attribute<float32> f : [ 2.5, 9.0 ];
	}

	unit<uint32> AB := union_unit(Ax, Bx)
	{
		attribute<uint32>  v := ordered_union_data(., Ax/v, Bx/v);
		attribute<float32> f := ordered_union_data(., Ax/f, Bx/f);

		// the accepted result must be the plain concatenation, i.e. what union_data yields
		attribute<uint32>  v_plain := union_data(., Ax/v, Bx/v);
		attribute<float32> f_plain := union_data(., Ax/f, Bx/f);
	}

	// one data item that already has the resulting domain: the pass-through path of CalcResult
	attribute<uint32> single (Ax) := ordered_union_data(Ax, Ax/v);

	container checks
	{
		parameter<bool>   v_ok   := all(AB/v == AB/v_plain), IntegrityCheck = "v_ok == true";
		parameter<bool>   f_ok   := all(AB/f == AB/f_plain), IntegrityCheck = "f_ok == true";
		parameter<bool>   one_ok := all(single == Ax/v),      IntegrityCheck = "one_ok == true";
		parameter<uint32> n      := #AB,                     IntegrityCheck = "n == 5";
		parameter<uint32> v_sum  := sum(AB/v),               IntegrityCheck = "v_sum == 16";
	}
}
