// control for the SampleFormat cases: the same 8-bit image with SampleFormat = 1 (data/tif_u8_sf.tif)
container stor_tif_u8_sf
{
	unit<spoint> dom := range(spoint, point_yx(0s, 0s), point_yx(4s, 8s));
	attribute<uint8> img (dom): StorageName = "%currDir%/data/tif_u8_sf.tif", StorageType = "tif";
	container checks
	{
		parameter<uint32> s := sum(uint32(img)), IntegrityCheck = "s == 496";
	}
}
