container fn_test_selmeta
{
	// §12.9 select-family meta collectors, POSITIVE (config scope): the
	// meta-select operators (select_with_attr_by_cond & co.) generate one
	// collected member per matching data-item child of the attribute
	// container, over a fresh subset unit. At config scope the checker never
	// runs — this is the ordinary working form and the reference semantics.
	unit<uint32> Dx : nrofrows = 4;
	container attrs
	{
		attribute<float64> population (Dx) : [10.0, 20.0, 30.0, 40.0];
		attribute<bool>    cond       (Dx) : [false, true, true, false];
	}

	// select_with_attr_by_cond(attrs, cond) -> unit<uint32> sel { population : attribute<float64>(sel) }
	unit<uint32> sel := select_with_attr_by_cond(attrs, attrs/cond);
	attribute<float64> selPop (sel) := sel/population;

	container checks
	{
		parameter<float64> c_1 := sum(selPop), IntegrityCheck = "c_1 == 50.0"; // 20+30
	}
}
