// max_index and min_index take a value only when it is strictly better than the start of their search,
// MIN_VALUE of the value type for max_index and MAX_VALUE for min_index. For unsigned and bool data
// MIN_VALUE is 0, so max_index of values that are all 0, in the whole domain or in one partition, is
// null: max_index of bool data is the first true and null where none is, which configurations use to
// mean that nothing was selected (Hestia's S-curve choice, the regression test t2000).
// 20.22.0 changed this to the index of the first value (doc/code-audit-2026-09-27.md CLC-A07), which
// turned "nothing selected" into a choice of the first option; 20.22.1 restores it, and this case
// checks it.
// Expected: exit 0 on /checks.
container oper_minmax_index_start_value
{
	unit<uint32> P : nrofrows = 2;

	unit<uint32> D : nrofrows = 6
	{
		attribute<uint32> zero : [0, 0, 0, 0, 0, 0];
		attribute<uint32> v    : [0, 0, 0, 3, 5, 5];
		attribute<bool>   sel  : [False, False, False, False, True, True];
		attribute<P>      part : [0, 0, 0, 1, 1, 1];
	}

	container checks
	{
		parameter<D>     max_zero     := max_index(D/zero);
		attribute<D>     max_part (P) := max_index(D/v, D/part);
		attribute<D>     min_part (P) := min_index(D/v, D/part);
		attribute<D>     sel_part (P) := max_index(D/sel, D/part);

		parameter<bool> max_zero_ok := !IsDefined(max_zero), IntegrityCheck = "max_zero_ok == true";
		parameter<bool> max_part_ok := !IsDefined(max_part[0]) && uint32(max_part[1]) == 4, IntegrityCheck = "max_part_ok == true";
		parameter<bool> min_part_ok := uint32(min_part[0]) == 0 && uint32(min_part[1]) == 3, IntegrityCheck = "min_part_ok == true";
		parameter<bool> sel_part_ok := !IsDefined(sel_part[0]) && uint32(sel_part[1]) == 4, IntegrityCheck = "sel_part_ok == true";
	}
}
