container fn_test_argcontainer_neg2
{
	// K11b negative (container PARAMETER): the NAMED suitability members are
	// declared over 'other', a DIFFERENT telescope unit parameter than the
	// allocUnit argument 'cells'. discrete_alloc reads them over the allocUnit, so
	// this is a rigid-rigid conflict at the DEFINITION — it holds for every
	// instantiation, and no allocation is reduced.
	unit<uint8>  LuType : nrofrows = 2 { attribute<string> name : ['LuA','LuB']; }
	unit<uint32> CellDom  : nrofrows = 4;
	container CMin { parameter<uint32> LuA := 1; parameter<uint32> LuB := 1; }
	container CMax { parameter<uint32> LuA := 4; parameter<uint32> LuB := 4; }
	parameter<int32> thr := 0i;

	function alloc_bad(unit<uint32> cells; unit<uint32> other;
	                   container suitArg { attribute<int32> LuA (other); attribute<int32> LuB (other); })
	-> parameter<uint32>
	{
		container alloc := discrete_alloc_np(LuType/name, cells, suitArg, CMin, CMax, thr);
		attribute<LuType> lu (cells) := alloc/landuse;
		parameter<uint32> result := sum(uint32(IsDefined(lu)));
	}

	container Suit
	{
		attribute<int32> LuA (CellDom) := const(1i, CellDom);
		attribute<int32> LuB (CellDom) := const(1i, CellDom);
	}
	parameter<uint32> n := alloc_bad(CellDom, CellDom, Suit);

	container checks { parameter<uint32> c := n, IntegrityCheck = "c == 4"; }
}
