container fn_test_da_pi64
{
	// Issue #1196: the discrete_alloc _pi64 names are the same allocation with the
	// Simulation-of-Simplicity perturbation term carried in Int64 instead of Int32. On any
	// configuration small enough to run here the two must agree cell for cell and price for
	// price -- that equivalence is what this case pins down.
	//
	// The overflow that _pi64 exists for needs ~2^31 land units and cannot be reached from a
	// testcase; what CAN be regression-tested is that widening the perturbation changes
	// nothing else. It very nearly did: the facet's perturbation factor was formed as an
	// UNSIGNED difference of two type ids, which only came out right because the result was
	// narrowed back to Int32.
	//
	// greedy_alloc and needy_alloc have no _pi64 twin -- they use neither shadow prices nor
	// the perturbation -- so there is nothing to compare for them here.
	unit<uint8>  LuType : nrofrows = 3 { attribute<string> name : ['LuA','LuB','LuC']; }
	unit<uint32> CellDom  : nrofrows = 8;

	container Suit
	{
		attribute<int32> LuA (CellDom) : [9,8,7,6,5,4,3,2];
		attribute<int32> LuB (CellDom) : [2,3,4,5,6,7,8,9];
		attribute<int32> LuC (CellDom) : [1,1,1,1,1,1,1,1];
	}
	// LuA's and LuB's maxima bind, so shadow prices have to move and the perturbation is really used
	container CMin { parameter<uint32> LuA := 0; parameter<uint32> LuB := 0; parameter<uint32> LuC := 0; }
	container CMax { parameter<uint32> LuA := 2; parameter<uint32> LuB := 3; parameter<uint32> LuC := 8; }
	parameter<int32> thr := 0i;

	container da32 := discrete_alloc_np     (LuType/name, CellDom, Suit, CMin, CMax, thr);
	container da64 := discrete_alloc_np_pi64(LuType/name, CellDom, Suit, CMin, CMax, thr);

	container checks
	{
		// same land use, cell for cell
		parameter<uint32> nrEqualLanduse := sum(uint32(da32/landuse == da64/landuse))
		,	IntegrityCheck = "nrEqualLanduse == 8";

		// same shadow prices, so the wider perturbation leaves the price arithmetic alone
		parameter<uint32> nrEqualPrices :=
				uint32(da32/shadow_prices/LuA == da64/shadow_prices/LuA)
			+	uint32(da32/shadow_prices/LuB == da64/shadow_prices/LuB)
			+	uint32(da32/shadow_prices/LuC == da64/shadow_prices/LuC)
		,	IntegrityCheck = "nrEqualPrices == 3";

		// same totals per type
		parameter<uint32> nrEqualTotals :=
				uint32(da32/total_allocated/LuA == da64/total_allocated/LuA)
			+	uint32(da32/total_allocated/LuB == da64/total_allocated/LuB)
			+	uint32(da32/total_allocated/LuC == da64/total_allocated/LuC)
		,	IntegrityCheck = "nrEqualTotals == 3";

		// every cell is placed
		parameter<uint32> allocated := da64/total_allocated/LuA + da64/total_allocated/LuB + da64/total_allocated/LuC
		,	IntegrityCheck = "allocated == 8";
	}
}
