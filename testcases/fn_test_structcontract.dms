container fn_test_structcontract
{
	// K11a-3 contract-check review positives (each a REPRODUCED false rejection,
	// fixed): (a) a def-scope external referenced beside a structured FIRST
	// parameter (the overloaded ResolveName code-2 must not reach the member map);
	// (b) a void-domain (parameter<>) member broadcasts; (c) 'apply' on a classic
	// template whose unit parameter carries a rule-bearing helper local; (d) a
	// declared CONTAINER member is a legal direct reference (deferred typing).
	parameter<float64> bias := 2.0;

	unit<uint32> Net : nrofrows = 3
	{
		unit<uint32> nodeset : nrofrows = 4;
		attribute<nodeset> F1 : [ 0, 1, 2 ];
		parameter<float64> w := 10.0;
		container meta { parameter<float64> factor := 3.0; }
	}

	// (a) external 'bias' + (b) void member w + (d) container member meta
	function f( unit<uint32> nw {
		unit<uint32> nodeset;
		attribute<nodeset> F1;
		parameter<float64> w;
		container meta { parameter<float64> factor; }
	} )
	-> parameter<float64> := float64(sum(pcount(nw/F1))) + nw/w + nw/meta/factor + bias;

	parameter<float64> t1 := f(Net);

	// (c) apply on a plain template with a helper-bearing unit parameter
	unit<uint32> Road : nrofrows = 3 { attribute<float64> flow : [ 1.0, 2.0, 3.0 ]; }
	Template Doubler
	{
		unit<uint32> D { attribute<uint32> helper := id(.); }
		attribute<float64> x (D);
		attribute<float64> result (D) := 2.0 * x;
	}
	attribute<float64> dbl (Road) := apply Doubler(Road, Road/flow);

	container checks
	{
		parameter<float64> c1 := t1,       IntegrityCheck = "c1 == 18.0";  // 3 + 10 + 3 + 2
		parameter<float64> c2 := sum(dbl), IntegrityCheck = "c2 == 12.0";
	}
}
