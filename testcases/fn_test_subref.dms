container fn_test_subref
{
	// §12.7 slSubItemCall tranche, the FLAGSHIP positive: composite-result
	// member references in an inline function body WORK end-to-end.
	// u := unique(src) types as an existential unit U; u/Values as
	// attribute<V>(U) with V riding the FORMAL's rigid node — the rlookup/
	// lookup roundtrip must scan clean at definition AND compute (identity).
	unit<uint32> Dx : nrofrows = 4;
	attribute<float64> x (Dx) : [1.0, 2.0, 2.0, 3.0];

	function f<Vx: numerics, DD: domains>(attribute<Vx> src (DD)) -> attribute<Vx> (DD)
	{
		unit<uint32> u := unique(src);
		attribute<Vx> result (DD) := u/Values[rlookup(src, u/Values)];
	}
	attribute<float64> y (Dx) := f(x);

	// lowercase member reference: the engine's item lookup is case-insensitive,
	// so the checker's member map must be too
	function g(attribute<float64> src (Dx)) -> parameter<float64>
	{
		unit<uint32> u := unique(src);
		parameter<float64> result := sum(u/Values);
	}
	parameter<float64> s := g(x);

	container checks
	{
		parameter<float64> c_1 := sum(y), IntegrityCheck = "c_1 == 8.0"; // identity roundtrip
		parameter<float64> c_2 := s,      IntegrityCheck = "c_2 == 6.0"; // 1+2+3
	}
}
