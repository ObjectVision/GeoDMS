// STG-A12: a palette TIFF of 4 bits read through tif into uint8 (data/tif_u4_palette.tif, 5 x 3, pixel k is 15 - k);
// refused as a mismatch of bits before 20.24.0, and the expansion read each pair of pixels in reverse and the last
// pixel of a row of odd width as its padding. The uint4 read of the same file is the control.
container stor_tif_u4_palette
{
	unit<spoint> dom := range(spoint, point_yx(0s, 0s), point_yx(3s, 5s));
	attribute<uint8> img  (dom): StorageName = "%currDir%/data/tif_u4_palette.tif", StorageType = "tif";
	attribute<uint4> img4 (dom): StorageName = "%currDir%/data/tif_u4_palette.tif", StorageType = "tif";
	container checks
	{
		attribute<uint32> k        (dom) := uint32(pointrow(id(dom))) * 5 + uint32(pointcol(id(dom)));
		attribute<uint32> expected (dom) := 15 - k;
		parameter<uint32> nrWrong  := sum(uint32(uint32(img)  != expected)), IntegrityCheck = "nrWrong == 0";
		parameter<uint32> nrWrong4 := sum(uint32(uint32(img4) != expected)), IntegrityCheck = "nrWrong4 == 0";
	}
}
