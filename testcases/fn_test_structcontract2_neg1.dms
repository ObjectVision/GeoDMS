// EXPECT-FAILURE: '/f': the argument for parameter 'nw' does not match its declared members: member 'N2_rel' is missing
container fn_test_structcontract2_neg1
{
	// K11a-3 on the INSTANTIATE path, negative: the argument lacks the declared
	// member N2_rel — the boundary check reports "member 'N2_rel' is missing" at the
	// application, where previously the instantiate path bypassed the check and
	// the failure surfaced as a transitive "Unknown identifier 'nw/N2_rel'" inside the
	// copied body.
	unit<uint32> Net : nrofrows = 3
	{
		unit<uint32> nodeset : nrofrows = 3;
		attribute<nodeset> N1_rel : [ 0, 1, 2 ];
	}

	function f( unit<uint32> nw {
		unit<uint32> nodeset;
		attribute<nodeset> N1_rel;
		attribute<nodeset> N2_rel;
	} ) -> parameter<uint32> := sum(pcount(nw/N1_rel) + pcount(nw/N2_rel));

	container inst := instantiate f(Net);

	container checks { parameter<uint32> c := inst/result, IntegrityCheck = "c == 6"; }
}
