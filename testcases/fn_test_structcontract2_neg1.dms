container fn_test_structcontract2_neg1
{
	// K11a-3 on the INSTANTIATE path, negative: the argument lacks the declared
	// member F2 — the boundary check reports "member 'F2' is missing" at the
	// application, where previously the instantiate path bypassed the check and
	// the failure surfaced as a transitive "Unknown identifier 'nw/F2'" inside the
	// copied body.
	unit<uint32> Net : nrofrows = 3
	{
		unit<uint32> nodeset : nrofrows = 3;
		attribute<nodeset> F1 : [ 0, 1, 2 ];
	}

	function f( unit<uint32> nw {
		unit<uint32> nodeset;
		attribute<nodeset> F1;
		attribute<nodeset> F2;
	} ) -> parameter<uint32> := sum(pcount(nw/F1) + pcount(nw/F2));

	container inst := instantiate f(Net);

	container checks { parameter<uint32> c := inst/result, IntegrityCheck = "c == 6"; }
}
