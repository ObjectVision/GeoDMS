// geos_buffer_multi_polygon and geos_buffer of a polygon give their third argument to GEOS as it is, which GEOS takes
// as segments per quarter circle; the point and arc buffers and the bg_ family convert it from points per circle. The
// difference is kept on purpose: models are calibrated on it (RSopen buffers its buildings with 4, the regression test
// t641). 20.22.0 converted it for polygons too (doc/code-audit-2026-09-27.md GEO-A19); 20.22.1 reverts that.
// A 10 x 10 square buffered by 1 with 16 gets 4 round corners of 16 segments each, about 68 vertices, where the
// conversion gave about 20. Expected: exit 0 on /checks.
container geo_geos_buffer_polygon_ppc
{
	unit<fpoint> crd;
	unit<uint32> Sq: nrofrows = 1;
	unit<uint32> SqPt: nrofrows = 5
	{
		attribute<float32> x : [0, 10, 10, 0, 0];
		attribute<float32> y : [0, 0, 10, 10, 0];
		attribute<Sq>      s := const(0, ., Sq);
		attribute<uint32>  o := id(.);
	}
	attribute<crd> square (Sq, polygon) := points2polygon(point_xy(SqPt/x, SqPt/y, crd), SqPt/s, SqPt/o);
	attribute<crd> buffered (Sq, polygon) := geos_buffer_multi_polygon(square, 1.0, 16b);

	unit<uint32> BufPt := sequence2points(buffered);

	container checks
	{
		parameter<uint32> nVertices := #BufPt, IntegrityCheck = "nVertices >= 60 && nVertices <= 72";
	}
}
