container fn_test_variant2_neg
{
	unit<uint32> Dx : nrofrows = 2 { attribute<float64> f : [ 1.0, 2.0 ]; }

	// (numerics, float64) and (float64, numerics) overlap at (float64, float64)
	// without either being more specific: rejected at definition
	function bad
	{
		variant a<Vx: numerics>(attribute<Vx> x (Dx); attribute<float64> y (Dx)) -> attribute<float64> (Dx) := y;
		variant b<Wx: numerics>(attribute<float64> x (Dx); attribute<Wx> y (Dx)) -> attribute<float64> (Dx) := x;
	}

	attribute<float64> use (Dx) := bad(Dx/f, Dx/f);
	container checks { parameter<float64> c := sum(use); }
}
