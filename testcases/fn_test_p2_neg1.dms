container fn_test_p2_neg1
{
	unit<uint32> Road : nrofrows = 2
	{
		attribute<string> names : [ 'a', 'b' ];
	}

	function TwiceG<Vx: numerics>(unit<uint32> Dx; attribute<Vx> x (Dx))
	-> attribute<Vx> (Dx) := x + x;

	attribute<string> failing (Road) := TwiceG(Road, Road/names);   // expect: does not satisfy 'V: numerics'
}
