// GEO-A20: the region unit of a partitioning must have a range that starts at 0, as the allocation operators
// index the claims with its ids. RegA is range(uint8, 1, 3) here and PA puts every atomic region in region 1,
// whose maximum claim for LuA is 1. The claims were indexed with the id itself, so region 1 got the claims
// of region 2 (at most 4), and the top value 2 was refused as out of range.
// Expected: exit nonzero on /checks
// ("the region unit of partitioning PA must have a range that starts at 0 ...").
// See oper_alloc_partitioning.dms, the same allocation on zero-based units.
container oper_alloc_region_base_neg
{
	unit<uint8>  Parts : nrofrows = 2 { attribute<string> name : ['PA', 'PB']; }
	unit<uint8>  LuType : nrofrows = 2
	{
		attribute<string> name         : ['LuA', 'LuB'];
		attribute<Parts>  partitioning : [0, 1];
	}
	unit<uint8>  RegA := range(uint8, uint8(1), uint8(3));
	unit<uint8>  RegB : nrofrows = 1;

	unit<uint16> AtomicRegion : nrofrows = 3
	{
		attribute<RegA> PA : [1, 1, 1];
		attribute<RegB> PB : [0, 0, 0];
	}
	unit<uint32> Cell : nrofrows = 8
	{
		attribute<uint32>       raw : [0, 0, 1, 1, 2, 2, 1, 0];
		attribute<AtomicRegion> ar  := value(uint16(raw), AtomicRegion);
	}
	container Suit
	{
		attribute<int32> LuA (Cell) : [9, 8, 7, 6, 5, 4, 3, 2];
		attribute<int32> LuB (Cell) : [2, 3, 4, 5, 6, 7, 8, 9];
	}
	container CMin { attribute<uint32> LuA (RegA) : [0, 0]; attribute<uint32> LuB (RegB) : [0]; }
	container CMax { attribute<uint32> LuA (RegA) : [1, 4]; attribute<uint32> LuB (RegB) : [8]; }
	parameter<int32> thr := 0i;
	container Feasible;

	container da := discrete_alloc(LuType/name, Cell, Suit, LuType/partitioning, Parts/name, AtomicRegion, Cell/ar, CMin, CMax, thr, Feasible);

	container checks
	{
		parameter<uint32> nLuA       := sum(uint32(da/landuse == 0b));
		parameter<uint32> nAllocated := sum(uint32(IsDefined(da/landuse))), IntegrityCheck = "nAllocated == 8";
	}
}
