// greedy_alloc with a null in a partitioning attribute: PA maps atomic region 2 onto no region of RegA.
// The region of every atomic region is checked, in every regime and before anything is allocated, also
// in a later tile of a tiled atomic region unit, as here: TiledAtomicRegion has 3 tiles of 1 atomic region.
// Expected: exit nonzero on /checks
// ("Value null for atomic region 2 out of range [0, 2) of the regions of [[/RegA]]").
// See oper_alloc_partitioning.dms, which is the same config with a valid PA.
container oper_alloc_partitioning_neg_null
{
	unit<uint8>  Parts : nrofrows = 2 { attribute<string> name : ['PA', 'PB']; }
	unit<uint8>  LuType : nrofrows = 2
	{
		attribute<string> name         : ['LuA', 'LuB'];
		attribute<Parts>  partitioning : [0, 1];
	}
	unit<uint8>  RegA : nrofrows = 2;
	unit<uint8>  RegB : nrofrows = 1;

	unit<uint32> TiledAtomicRegion := TiledUnit(value(1, range(uint32, 0, 3))) // 3 tiles of 1 atomic region
	{
		attribute<RegA> PA : [0, 1, null];
		attribute<RegB> PB : [0, 0, 0];
	}

	unit<uint32> Cell : nrofrows = 8
	{
		attribute<uint32>            raw      : [0, 0, 1, 1, 2, 2, 1, 0];
		attribute<TiledAtomicRegion> tiled_ar := value(raw, TiledAtomicRegion);
	}
	container Suit
	{
		attribute<int32> LuA (Cell) : [9, 8, 7, 6, 5, 4, 3, 2];
		attribute<int32> LuB (Cell) : [2, 3, 4, 5, 6, 7, 8, 9];
	}
	container CMin { attribute<uint32> LuA (RegA) : [0, 0]; attribute<uint32> LuB (RegB) : [0]; }
	container CMax { attribute<uint32> LuA (RegA) : [1, 4]; attribute<uint32> LuB (RegB) : [8]; }
	parameter<int32> thr := 0i;
	container Feasible;

	container greedy_tiled := greedy_alloc(LuType/name, Cell, Suit, LuType/partitioning, Parts/name, TiledAtomicRegion, Cell/tiled_ar, CMin, CMax, thr, Feasible);

	container checks
	{
		parameter<uint32> n := sum(uint32(IsDefined(greedy_tiled/landuse))), IntegrityCheck = "n == 8";
	}
}