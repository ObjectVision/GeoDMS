container fn_test_da
{
	// §12.8 discrete_alloc array-spec join: in a function body,
	// a := discrete_alloc(...); alloc/landuse is typed attribute<AT>(allocUnit),
	// AT = the typeNames' DOMAIN — STRUCTURALLY, even when typeNames/allocUnit
	// are FORMALS (the ruling). This is the VALUES-conflict negative: landuse's
	// values ride AT (a domains-constrained type var D here), so a string
	// declaration fed from alloc/landuse is a DEFINITION-time conflict — proving
	// landuse's values == the typeNames domain, no discrete_alloc reduction.
	unit<uint8>  LuType : nrofrows = 2 { attribute<string> name : ['LuA','LuB']; }
	unit<uint32> CellDom  : nrofrows = 4;
	container Suit { attribute<float32> LuA (CellDom) := const(1f, CellDom); attribute<float32> LuB (CellDom) := const(1f, CellDom); }
	container CMin { parameter<uint32> LuA := 1; parameter<uint32> LuB := 1; }
	container CMax { parameter<uint32> LuA := 4; parameter<uint32> LuB := 4; }
	parameter<int32> thr := 0i;

	function f<Dx: domains>(attribute<string> tn (Dx); unit<uint32> cells) -> parameter<uint32>
	{
		container alloc := discrete_alloc_np(tn, cells, Suit, CMin, CMax, thr);
		attribute<string> bad (cells) := alloc/landuse; // landuse values = D (typeNames domain), declared string -> conflict
		parameter<uint32> result := #bad;
	}
	parameter<uint32> n := f(LuType/name, CellDom);

	container checks { parameter<uint32> c_1 := n, IntegrityCheck = "c_1 == 4"; }
}
