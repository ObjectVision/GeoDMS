container fn_test_scope_neg
{
	unit<uint32> Road : nrofrows = 2 { attribute<float64> flow : [ 1.0, 2.0 ]; }

	container lib
	{
		// 'callsite_only' is NOT visible from F's definition point; it lives at the
		// CALL site — call-site isolation must reject it
		function F(unit<uint32> Rd; attribute<float64> x (Rd))
		-> attribute<float64> (Rd) := x * callsite_only;
	}

	container site
	{
		parameter<float64> callsite_only := 10.0;
		attribute<float64> bad (/Road) := /lib/F(/Road, /Road/flow);
	}

	container checks { parameter<float64> use := sum(site/bad); }
}
