container fn_test_opsigB
{
	// op-sig batch B: the relational family's unit constraints, DERIVED from the
	// family bases (lookup K2 join-key, rlookup K4 result-values-is-arg2-domain,
	// invert double cross-role) and enforced through the shared UnitNode pool
	unit<uint32> Region : nrofrows = 2 { attribute<float64> avg : [10.0, 20.0]; }
	unit<uint32> House  : nrofrows = 3
	{
		attribute<Region>  reg   : [0, 1, 1];
		attribute<float64> price : [10.0, 20.0, 10.0];
	}
	unit<uint32> Pair : nrofrows = 2 { attribute<Region> pr : [1, 0]; }

	// lookup: E2 in org_rel's VALUES role and values' DOMAIN role — one node;
	// consistent concrete units bind it once from each side
	function avgOf<Dx: domains>(attribute<Region> r (Dx); attribute<float64> v (Region))
	-> attribute<float64> (Dx) := lookup(r, v);

	// rlookup: the result's VALUES unit IS b's domain (K4) — the declared result
	// values unit discharges against that identity
	function toRegion<Dx: domains>(attribute<float64> a (Dx); attribute<float64> b (Region))
	-> attribute<Region> (Dx) := rlookup(a, b);

	// invert: x's values unit becomes the result DOMAIN and x's domain the result
	// VALUES — both identities checked against the declared result
	function inv(attribute<Region> x (Pair)) -> attribute<Pair> (Region) := invert(x);

	// BORROWING REGRESSION (doc batch-B requirement): a rel whose values carry
	// only a value CLASS (the default uint32 unit at runtime) against a NAMED
	// domain must NOT error at definition — and lookup's UM_AllowDefaultLeft
	// borrow accepts it at reduction
	function pick<Dx: domains>(attribute<uint32> r (Dx); attribute<float64> v (Region))
	-> attribute<float64> (Dx) := lookup(r, v);

	// SEQUENCE-COMPOSITION REGRESSION (review finding): the record's tuples must
	// speak the walker's FIELD-class vocabulary — a sequence-composed values
	// argument through the K2 record must not error at definition. Meta-only:
	// sq stays dataless, and the check below reads only t5's domain unit
	attribute<float32> sq (Region, arc);
	function seqOf<Dx: domains>(attribute<Region> r (Dx); attribute<float32> s (Region, arc))
	-> attribute<float32> (Dx, arc) := lookup(r, s);
	attribute<float32> t5 (House, arc) := seqOf(House/reg, sq);

	attribute<float64> t1 (House)  := avgOf(House/reg, Region/avg);              // [10,20,20]
	attribute<Region>  t2 (House)  := toRegion(House/price, Region/avg);         // [0,1,0]
	attribute<Pair>    t3 (Region) := inv(Pair/pr);                              // [1,0]
	attribute<float64> t4 (House)  := pick(value(House/reg, uint32), Region/avg); // borrow: [10,20,20]

	container checks
	{
		parameter<float64> c_1 := sum(t1),         IntegrityCheck = "c_1 == 50.0";
		parameter<uint32>  c_2 := sum(uint32(t2)), IntegrityCheck = "c_2 == 1";
		parameter<uint32>  c_3 := sum(uint32(t3)), IntegrityCheck = "c_3 == 1";
		parameter<float64> c_4 := sum(t4),         IntegrityCheck = "c_4 == 50.0";
		parameter<uint32>  c_5 := nrofrows(DomainUnit(t5)), IntegrityCheck = "c_5 == 3";
	}
}
