container fn_test_unify_neg4
{
	// strlength is string -> uint32; composing it with fhalf (float64 -> float64)
	// forces the shared type variable V to be both float64 (from fhalf) and string
	// (from strlength) — an inconsistent instantiation caught at DEFINITION time
	// ("inconsistent instantiation of type variable 'V': float64 ... vs string ...").
	unit<uint32> Road : nrofrows = 3 { attribute<float64> flow : [ 1.0, 2.0, 3.0 ]; }

	nuf = function<Vx: numerics, Dx: domains>(attribute<Vx> (Dx)) -> attribute<Vx> (Dx);

	function fhalf(attribute<float64> x) -> attribute<float64> := x / 2.0;
	function strlength(attribute<string> str) -> attribute<uint32> := strlen(str);

	function compose<Vx: numerics, Dx: domains>(f: nuf<Vx, Dx>; g: nuf<Vx, Dx>) -> nuf<Vx, Dx>
	{
		function result(attribute<Vx> x (Dx)) -> attribute<Vx> (Dx) := f(g(x));
	}
	attribute<float64> bad (Road) := compose(fhalf, strlength)(Road/flow);

	container checks { parameter<float64> use := sum(bad); }
}
