container fn_test_unify_neg1
{
	unit<uint32> Road : nrofrows = 3 { attribute<float64> flow : [ 1.0, 2.0, 3.0 ]; }

	nuf = function<Vx: numerics, Dx: domains>(attribute<Vx> (Dx)) -> attribute<Vx> (Dx);

	function fhalf(attribute<float64> x) -> attribute<float64> := x / 2.0;  // V := float64
	function iinc (attribute<int32>   x) -> attribute<int32>   := x + 1;    // V := int32

	function compose<Vx: numerics, Dx: domains>(f: nuf<Vx, Dx>; g: nuf<Vx, Dx>) -> nuf<Vx, Dx>
	{
		function result(attribute<Vx> x (Dx)) -> attribute<Vx> (Dx) := f(g(x));
	}

	// float64 and int32 cannot both instantiate the same V
	attribute<float64> bad (Road) := compose(fhalf, iinc)(Road/flow);

	container checks { parameter<float64> use := sum(bad); }
}
