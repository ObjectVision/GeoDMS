// #1304: profile_slot_factor has one factor per profile and time slot, so its count is a multiple of the number
// of profiles. Three factors for two profiles are refused with "timedependent: profile_slot_factor has 3 elements,
// which is not a positive multiple of the 2 profiles of link_profile_rel ...". Expected: exit nonzero on /checks.
container fn_test_od_timedep_neg1
{
	unit<uint32> Profile : nrofrows = 2;
	unit<uint32> ProfileSlot : nrofrows = 3 { attribute<float64> factor : [1.0, 0.5, 1.0]; }
	unit<uint32> Node : nrofrows = 2;
	unit<uint32> Link : nrofrows = 1
	{
		attribute<Node>    N1_rel  : [0];
		attribute<Node>    N2_rel  : [1];
		attribute<float64> t       : [10.0];
		attribute<Profile> profile_rel : [0];
	}
	unit<uint32> StartSet : nrofrows = 1
	{
		attribute<Node>    node_rel  : [0];
		attribute<float64> departure : [0.0];
	}
	unit<uint32> EndSet : nrofrows = 1 { attribute<Node> node_rel : [1]; }

	unit<uint32> od := impedance_matrix(
		  'directed;startPoint(Node_rel);endPoint(Node_rel)'
		  ';timedependent(link_profile_rel,profile_slot_factor,slot_duration,departure_time)'
		  ';od:impedance'
		, Link/t, Link/N1_rel, Link/N2_rel
		, StartSet/node_rel, EndSet/node_rel
		, Link/profile_rel, ProfileSlot/factor, 10.0, StartSet/departure
		);

	container checks
	{
		parameter<float64> total := sum(od/impedance), IntegrityCheck = "total > 0.0";
	}
}
