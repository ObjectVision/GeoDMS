// #1282: the epsilon of pareto_optimal_eps is relative, a fraction from 0 to 1. A bucket width in the unit of
// the criterion, as the builds until 2026-10-05 took it, such as 2.0 here, is refused with "pareto_optimal_eps:
// the epsilon of criterion 2 must be a fraction from 0 to 1 (0.01 = 1%); ...". Expected: exit nonzero on /checks.
container fn_test_pareto_eps_neg1
{
	unit<uint32> P : nrofrows = 1;
	unit<uint32> E : nrofrows = 4
	{
		attribute<P>       part  : [0, 0, 0, 0];
		attribute<float64> time  : [1, 2, 3, 4];
		attribute<float64> price : [4, 3, 2, 1];
		attribute<bool>    po    := pareto_optimal_eps(part, time, price, 2.0);
	}

	container checks
	{
		parameter<uint32> n := sum(uint32(E/po)), IntegrityCheck = "n > 0";
	}
}
