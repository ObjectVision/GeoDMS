container fn_test_subref_neg5
{
	// §12.7 slSubItemCall tranche (review fix, live-repro'd): a local whose
	// rule is a BARE config-item alias reduces to a sourceDescr key — NOT a
	// cache result — so the member access must keep the pre-tranche throw
	// ("Cannot find sub from ..."), never wrap it in slSubItemCall (which
	// asserts on non-cache bases in Debug).
	unit<uint32> D : nrofrows = 4;
	container ext
	{
		attribute<float64> sub (D) : [1.0, 2.0, 2.0, 3.0];
	}

	function f(attribute<float64> v (D)) -> parameter<float64>
	{
		container c := ext;
		parameter<float64> result := sum(c/sub) + sum(v);
	}
	parameter<float64> s := f(ext/sub);

	container checks
	{
		parameter<float64> c_1 := s, IntegrityCheck = "c_1 == 0.0";
	}
}
