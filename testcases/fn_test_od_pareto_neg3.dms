container fn_test_od_pareto_neg3
{
	// In pareto mode the alternative impedances DRIVE pruning, so they get the same
	// nonnegativity requirement as the primary impedance: a negative imp2 cycle would make the
	// per-node label set unbounded. The negative value below must be rejected at calculation.
	unit<uint32> Node : nrofrows = 2;
	unit<uint32> Link : nrofrows = 1
	{
		attribute<Node>    N1_rel  : [0];
		attribute<Node>    N2_rel  : [1];
		attribute<float64> imp : [1.0];
		attribute<float64> c   : [-1.0];
	}
	unit<uint32> StartSet : nrofrows = 1 { attribute<Node> nr : [0]; }
	unit<uint32> EndSet   : nrofrows = 1 { attribute<Node> nr : [1]; }

	unit<uint32> od := impedance_matrix(
		  'directed;startPoint(Node_rel);endPoint(Node_rel);cut(OrgZone_max_imp);alternative(link_imp):alt_imp;pareto;od:impedance'
		, Link/imp, Link/N1_rel, Link/N2_rel
		, StartSet/nr, EndSet/nr
		, const(100.0, StartSet)
		, Link/c
		);

	container checks
	{
		parameter<uint32> nr_rows := uint32(#od), IntegrityCheck = "nr_rows == 1";
	}
}
