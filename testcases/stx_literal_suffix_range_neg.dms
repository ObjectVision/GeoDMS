// Regression for doc/code-audit-2026-09-27.md STX-A25: a literal whose value the type of its suffix cannot
// hold, such as 300b for a uint8, was cast to null at run time without a word, while an unsuffixed integer
// above uint32 is a parse error. Since 20.24.0 it is an error that names the literal and the type.
// Expected: nonzero exit on /checks, "the literal 300b is outside the range of uint8".
container stx_literal_suffix_range_neg
{
	parameter<uint8> x := 300b;

	container checks
	{
		parameter<bool> ok := IsDefined(x), IntegrityCheck = "ok == true";
	}
}
