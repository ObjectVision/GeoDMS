container fn_test_sig_neg
{
	unary_fn = (unit<uint32> Dx; attribute<float64> v (Dx)) -> attribute<float64> (Dx);

	function Wrong3(unit<uint32> Dx; attribute<float64> v (Dx); parameter<float64> extra)
	-> attribute<float64> (Dx) := v;

	function ApplyT(unit<uint32> Dx; f: unary_fn; attribute<float64> x (Dx))
	-> attribute<float64> (Dx) := f(Dx, x);

	unit<uint32> Road : nrofrows = 2
	{
		attribute<float64> flow : [ 1.0, 2.0 ];
	}

	attribute<float64> failing (Road) := ApplyT(Road, Wrong3, Road/flow);   // expect: signature arity mismatch
}
