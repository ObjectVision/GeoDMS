container fn_test_opsigF_neg2
{
	// NEGATIVE (definition-time, batch F): dist_info's result domain IS the
	// points domain (K3 — CreateResult unconditionally builds
	// CreateCacheDataItem(pointEntity, defaultDistUnit), Connect.cpp). The
	// derived signature shares one unit variable Dp between the points argument
	// and the result domain, so declaring the result over the ARC domain A —
	// an independent domain generic — errors at the definition's first
	// reference. At reduction the same config throws in CheckResultItem's
	// domain UnifyDomain discharge.
	// Expected: "the definition of '/bad': the body requires unit variables
	//            'D' and 'A' to be equal ... independent ..."
	unit<uint32> ArcSet : nrofrows = 1;
	unit<uint32> PointSrc : nrofrows = 2;
	attribute<float32> ay   (PointSrc) : [0, 0];
	attribute<float32> ax   (PointSrc) : [0, 10];
	attribute<fpoint>  apt  (PointSrc) := point_yx(ay, ax, fpoint);
	attribute<ArcSet>  seqr (PointSrc) : [0, 0];
	attribute<uint32>  ord  (PointSrc) : [0, 1];

	attribute<fpoint> arcs (ArcSet, arc) := points2sequence(apt, seqr, ord);

	unit<uint32> P : nrofrows = 2;
	attribute<float32> py  (P) : [1, 3];
	attribute<float32> px  (P) : [2, 5];
	attribute<fpoint>  pts (P) := point_yx(py, px, fpoint);

	function bad<A: domains, D: domains>(attribute<fpoint> a (A, arc); attribute<fpoint> p (D))
	-> attribute<float64> (A) := dist_info(a, p);

	attribute<float64> z (ArcSet) := bad(arcs, pts);

	container checks { parameter<float64> use := sum(z); }
}
