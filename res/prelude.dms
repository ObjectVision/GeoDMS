//////////////////////////////////////////////////////////////////////////////
// GeoDms standard prelude (GeoDms >= 20.9.0)
//
// Typed replacements for retired RewriteExpr.lsp definitional rules (WP4.5,
// doc/development/typed-hof-language-design.md section 8). Include with:
//
//   #include <%exeDir%/prelude.dms>
//
// KEY-IDENTITY CONTRACT: every function body below is written as the exact
// fixpoint expansion its retired rewrite rule used to produce, and function
// applications beta-reduce fully into the surrounding key expression. Hence
// e.g. sqr(x) keys as (mul xKey xKey) — byte-identical to the old rule — so
// CalcCache entries and cross-spelling unit unification are preserved.
// Changing a body here changes cache identity: treat bodies as interface.
//////////////////////////////////////////////////////////////////////////////

// ---------------------------------------------------------------- elementary

function sqr<V: numerics>(attribute<V> x) -> attribute<V> := x * x;

function plogp<F: floats>(attribute<F> x) -> attribute<F> := MakeDefined(x * log(x), 0.0);

function abs<V: numerics>(attribute<V> x) -> attribute<V> := isNegative(x) ? -x : x;

// ---------------------------------------------------------------- ordering (WP4.5 tranche 3)

function sort_str(attribute<string> x) -> attribute<string> := lookup(index(x), x);

// D is a plain parameter binding any domain unit; the result ranges over D
function reversed_id(container D) -> container := (UpperBound(D) + LowerBound(D) - id(D)) - convert(1, D);

function reverse<T: any>(attribute<T> x) -> attribute<T> := lookup(reversed_id(DomainUnit(x)), x);

// ---------------------------------------------------------------- proximity (WP4.5 tranche 3)
// the retained 'order' and 'isOverlapping' rewrite rules fire at body-parse
// fixpoint on these spellings, so the reduced keys equal the old rule chain

function neighbourhood<V: numerics>(attribute<V> x; attribute<V> f) -> container := order(x, f * x);

function float_isNearby<V: numerics>(attribute<V> a; attribute<V> b; attribute<V> f)
-> attribute<bool> := isOverlapping(order(a, f * a), order(b, f * b));

function point_isNearby<P: points, V: numerics>(attribute<P> a; attribute<P> b; attribute<V> f)
-> attribute<bool> := float_isNearby(pointrow(a), pointrow(b), f) && float_isNearby(pointcol(a), pointcol(b), f);

// ---------------------------------------------------------------- property accessors
// 'item' parameters are meta-references: the argument binds as a raw item reference
// (never its calculation/range key), so PropValue reads the CONFIG item's metadata —
// for containers, units and attributes alike — and each application keys identically
// to the direct PropValue call.

function name   (item t) -> parameter<string> := PropValue(t, 'name');
function Descr  (item t) -> parameter<string> := PropValue(t, 'Descr');
function Expr   (item t) -> parameter<string> := PropValue(t, 'Expr');
function Label  (item t) -> parameter<string> := PropValue(t, 'Label');
function STORAGE(item t) -> parameter<string> := PropValue(t, 'StorageName');
function EK     (item t) -> parameter<string> := PropValue(t, 'ExternalKeyData');

// ---------------------------------------------------------------- variadic folds
// '...rest' parameters bind the argument tail; each recursive step consumes one
// (or one group of) leading argument(s), so the fold terminates structurally.
// KEY IDENTITY: each body spells the exact resolvent of the retired rewrite rule;
// the retained rules (MakeDefined -> iif, Value -> convert) fire at body parse,
// so the fully reduced keys equal the old rule-chain fixpoints byte for byte.

function concat
{
	variant none() -> parameter<string> := '';
	variant one(attribute<string> a) -> attribute<string> := MakeDefined(a, '');
	variant more(attribute<string> a; ...rest) -> attribute<string> := MakeDefined(a, '') + concat(rest);
}

function replace_value
{
	variant base(container x; container v; container w) -> container := iif(x == v, w, x);
	variant more(container x; container v; container w; ...rest) -> container
	:=	replace_value(replace_value(x, v, w), rest);
}

function combine_data
{
	variant base(container V; container a; container b) -> container
	:=	Value(
			(Int64(a) - Int64(LowerBound(ValuesUnit(a)))) * Int64(NrOfRows(ValuesUnit(b)))
			+ (Int64(b) - Int64(LowerBound(ValuesUnit(b))))
		,	V);
	variant more(container V; container a1; container a2; ...rest) -> container
	:=	combine_data(V, combine_data(combine_unit(ValuesUnit(a1), ValuesUnit(a2)), a1, a2), rest);
}

// MakeDefined: a pure rule head (no registered operator) — retired at ALL arities.
// The structural idempotence collapse MakeDefined(MakeDefined(x,y),y) -> MakeDefined(x,y)
// stays a rewrite rule (it destructures its argument); it normalizes the SOURCE and its
// output resolves to this function, so rule and function compose key-identically.
function MakeDefined
{
	variant one (container a) -> container := a;
	variant two (container x; container y) -> container := iif(IsDefined(x), x, y);
	variant more(container x; container y; ...rest) -> container := MakeDefined(MakeDefined(x, y), rest);
}

// median-of-3: the retained order + median-interval destructuring rules fire on this
// body at parse, so the stored body equals the old rule chain's fixpoint
function median
{
	variant three(container a; container b; container c) -> container := median(a, order(b, c));
}

// ---------------------------------------------------- arity-dispatched operator folds
// These serve ONLY argument counts the registered binary operators reject (1 and >=3):
// arity-aware head dispatch routes those counts here; arity 2 -- and the fold bodies'
// own binary inner calls -- always resolve to the OPERATOR. Bodies spell the retired
// fold rules' exact resolvents, so reduced keys equal the old chains.

function add { variant one(container a) -> container := a; variant more(container a; container b; ...rest) -> container := add(add(a, b), rest); }
function mul { variant one(container a) -> container := a; variant more(container a; container b; ...rest) -> container := mul(mul(a, b), rest); }
function or  { variant one(container a) -> container := a; variant more(container a; container b; ...rest) -> container := or(or(a, b), rest); }
function and { variant one(container a) -> container := a; variant more(container a; container b; ...rest) -> container := and(and(a, b), rest); }

// 2-arg log (the registered log operator is unary)
function log { variant two(container x; container b) -> container := log(x) / log(b); }

// ---------------------------------------------------------------- logit

function llpart<F: floats>(attribute<F> lc; attribute<F> xc; attribute<F> oc)
-> attribute<F> := oc * log(xc) - log(lc);

function ll1<F: floats>(attribute<F> lc; attribute<F> xc; attribute<F> oc)
-> attribute<F> := (oc * log(xc) - log(lc)) + ((lc - oc) * log(lc - xc) - log(lc));

// ---------------------------------------------------------------- rescaling
// multi-arity forms dispatch by argument count; P (a partition relation) is a
// plain parameter so any partition value type matches.

function scalesum
{
	variant total<V: numerics>(attribute<V> x; attribute<V> s)
	-> attribute<V> := isZero(s) ? s : x * (s / sum(x));

	variant partitioned<V: numerics>(attribute<V> x; container P; attribute<V> s)
	-> attribute<V> := isZero(lookup(P, s)) ? lookup(P, s) : x * lookup(P, s / sum(x, P));
}

function distribute
{
	variant total<V: numerics>(attribute<V> s; attribute<V> x)
	-> attribute<V> := isZero(s) ? s : x * (s / sum(x));

	variant partitioned<V: numerics>(attribute<V> s; attribute<V> x; container P)
	-> attribute<V> := isZero(lookup(P, s)) ? lookup(P, s) : x * lookup(P, s / sum(x, P));
}

function rescale
{
	variant unit_range<V: numerics>(attribute<V> x)
	-> attribute<V> := (x - min(x)) / (max(x) - min(x));

	variant to_range<V: numerics>(attribute<V> x; attribute<V> mn; attribute<V> mx)
	-> attribute<V> := (x - min(x)) * ((mx - mn) / (max(x) - min(x))) + mn;

	variant partitioned<V: numerics>(attribute<V> x; container P; attribute<V> mn; attribute<V> mx)
	-> attribute<V> := (x - lookup(P, min(x, P))) * lookup(P, (mx - mn) / (max(x, P) - min(x, P))) + mn;
}

function normalize
{
	variant standard<V: numerics>(attribute<V> x)
	-> attribute<V> := (x - mean(x)) / sd(x);

	variant shifted<V: numerics>(attribute<V> x; attribute<V> e)
	-> attribute<V> := (x - mean(x)) / sd(x) + e;

	variant scaled<V: numerics>(attribute<V> x; attribute<V> e; attribute<V> s)
	-> attribute<V> := (x - mean(x)) * (s / sd(x)) + e;
}

// ------------------------------------------------- null-aware predicates
// null-transparent comparisons: the *_or_lhs_null forms treat a null left
// operand as satisfying the relation; *_or_rhs_null mirror them.

function eq_or_both_null<T: any>(attribute<T> a; attribute<T> b)
-> attribute<bool> := (a == b) || (IsNull(a) && IsNull(b));

function ne_or_one_null<T: any>(attribute<T> a; attribute<T> b)
-> attribute<bool> := !((a == b) || (IsNull(a) && IsNull(b)));

function lt_or_lhs_null<T: any>(attribute<T> a; attribute<T> b)
-> attribute<bool> := (a < b) || (IsNull(a) && !IsNull(b));

function gt_or_lhs_null<T: any>(attribute<T> a; attribute<T> b)
-> attribute<bool> := (a > b) || (IsNull(a) && !IsNull(b));

function le_or_lhs_null<T: any>(attribute<T> a; attribute<T> b)
-> attribute<bool> := (a <= b) || IsNull(a);

function ge_or_lhs_null<T: any>(attribute<T> a; attribute<T> b)
-> attribute<bool> := (a >= b) || IsNull(a);

function lt_or_rhs_null<T: any>(attribute<T> a; attribute<T> b)
-> attribute<bool> := (b > a) || (IsNull(b) && !IsNull(a));

function gt_or_rhs_null<T: any>(attribute<T> a; attribute<T> b)
-> attribute<bool> := (b < a) || (IsNull(b) && !IsNull(a));

function le_or_rhs_null<T: any>(attribute<T> a; attribute<T> b)
-> attribute<bool> := (b >= a) || IsNull(b);

function ge_or_rhs_null<T: any>(attribute<T> a; attribute<T> b)
-> attribute<bool> := (b <= a) || IsNull(b);
