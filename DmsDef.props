<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="14.3" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_ProjectFileVersion>10.0.21006.1</_ProjectFileVersion>
    <_PropertySheetDisplayName>Dms</_PropertySheetDisplayName>
    <OutDir>$(SolutionDir)bin\$(Configuration)\$(Platform)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\$(Platform)\$(ProjectName)\</IntDir>
    <RunCodeAnalysis>false</RunCodeAnalysis>
	<CAExcludePath>c:\SourceData\ext\boost;$(CAExcludePath)</CAExcludePath>
	<Platforms>x64;x86</Platforms>
	<!-- /analyze:stacksize raises the C6262 (excessive-stack) warning threshold; it is an
	     /analyze: sub-option and is only valid while Code Analysis runs. Emit it ONLY when
	     analysis is on (RunCodeAnalysis=true, e.g. analyze.bat). Normal builds now pass
	     /analyze- via EnablePREfast=false; a leftover /analyze: option there triggers
	     warning D9025 and silently re-enables analysis, so keep it out of normal builds. -->
	<DmsAnalyzeStackOpt Condition="'$(RunCodeAnalysis)' == 'true'">/analyze:stacksize32768 </DmsAnalyzeStackOpt>
  </PropertyGroup>
  <!--
    Configuration-time settings (PlatformToolset, CharacterSet, PreferredToolArchitecture,
    UseOfMfc) now live in Directory.Build.props. They must be set before Microsoft.Cpp.props
    consumes them, but this file is imported as a property sheet (via DmsDebug/DmsRelease.props)
    AFTER Cpp.props, so setting them here had no effect. EnableUnitySupport is read later by the
    C++ targets, so it is still honored from this property sheet.
  -->
  <PropertyGroup>
    <EnableUnitySupport>true</EnableUnitySupport>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgAdditionalInstallOptions>--binarysource=clear;files,$(SolutionDir)\vc_archives,readwrite --downloads-root=$(SolutionDir)\vc_downloads</VcpkgAdditionalInstallOptions>
	<VcpkgTriplet>x64-windows-v145</VcpkgTriplet>
	<!-- Override default (vcpkg_installed\$(VcpkgTriplet)\) so the layout matches what cmake -->
	<!-- writes via -DVCPKG_INSTALLED_DIR=vcpkg_installed: a single $(VcpkgTriplet) level, -->
	<!-- not the doubly-nested vcpkg_installed\<triplet>\<triplet>\ MS's vcpkg.targets produces -->
	<!-- by default. Shared layout means .m and .c link against the same binaries. -->
	<VcpkgInstalledDir>$(SolutionDir)vcpkg_installed\</VcpkgInstalledDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Bscmake>
      <SuppressStartupBanner>true</SuppressStartupBanner>
    </Bscmake>
    <ClCompile>
      <!-- _CRT_NONSTDC_NO_WARNINGS: the POSIX-name deprecations (stricmp/strnicmp, C4996)
           were silenced by a #pragma warning(disable:4996) in cpc/CompChar.h, but pragma
           state does not survive the precompiled-header boundary under /sdl; the macro
           removes the deprecation from the CRT declarations themselves. -->
      <!-- _SILENCE_CXX17_STRSTREAM_DEPRECATION_WARNING: utl/mySPrintF.h still uses
           std::ostrstream (see its TODO); same pragma-vs-PCH story as above. -->
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;_SILENCE_CXX17_STRSTREAM_DEPRECATION_WARNING;BOOST_SPIRIT_USE_OLD_NAMESPACE;BOOST_SPIRIT_THREADSAFE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ExceptionHandling>Sync</ExceptionHandling>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <!-- Projects opt in to a real precompiled header by setting the DmsPchHeader property
           to their PCH header name (e.g. <DmsPchHeader>TicPCH.h</DmsPchHeader>). Every .cpp of
           such a project must #include exactly that header first (or set
           PrecompiledHeader=NotUsing per file); the PCH itself is created by the project's
           <Mod>PCH.cpp, marked PrecompiledHeader=Create. -->
      <PrecompiledHeader Condition="'$(DmsPchHeader)' != ''">Use</PrecompiledHeader>
      <PrecompiledHeaderFile Condition="'$(DmsPchHeader)' != ''">$(DmsPchHeader)</PrecompiledHeaderFile>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <WarningLevel>Level3</WarningLevel>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <DisableAnalyzeExternal>true</DisableAnalyzeExternal>
      <AnalyzeExternalRuleset>BasicCorrectnessRules.ruleset</AnalyzeExternalRuleset>
      <AdditionalOptions>/utf-8 /bigobj $(DmsAnalyzeStackOpt)/w14388 /w14389 %(AdditionalOptions)</AdditionalOptions>
      <SDLCheck>true</SDLCheck>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <ConformanceMode>true</ConformanceMode>
	  <ControlFlowGuard>Guard</ControlFlowGuard>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
	  <EnablePREfast>false</EnablePREfast>
	</ClCompile>
    <Link>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <LargeAddressAware>true</LargeAddressAware>
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <StackReserveSize>67108864</StackReserveSize>
      <StackCommitSize>8192</StackCommitSize>
    </Link>
    <Midl>
      <MkTypLibCompatible>true</MkTypLibCompatible>
      <SuppressStartupBanner>true</SuppressStartupBanner>
    </Midl>
    <ResourceCompile>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;BOOST_SPIRIT_USE_OLD_NAMESPACE;BOOST_SPIRIT_THREADSAFE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Culture>0x0409</Culture>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='Win32'">
    <Midl>
      <TargetEnvironment>Win32</TargetEnvironment>
    </Midl>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <Midl>
      <TargetEnvironment>ia64</TargetEnvironment>
    </Midl>
  </ItemDefinitionGroup>
</Project>