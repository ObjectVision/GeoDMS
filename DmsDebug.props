<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="14.1" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets">
    <Import Project="DmsDef.props" />
  </ImportGroup>
  <PropertyGroup>
    <_ProjectFileVersion>10.0.21006.1</_ProjectFileVersion>
    <LinkIncremental>true</LinkIncremental>
    <RunCodeAnalysis>false</RunCodeAnalysis>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgConfiguration Condition="'$(GeoDmsGlobio)' != 'true'">Debug</VcpkgConfiguration>
    <!-- The GLOBIO conda SDK is a release ABI. A G Debug build keeps debug
         symbols/assertions but must use release CRT/STL and release vcpkg libs
         when calling GEOS's C++ API across the DLL boundary. -->
    <VcpkgConfiguration Condition="'$(GeoDmsGlobio)' == 'true'">Release</VcpkgConfiguration>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;_ITERATOR_DEBUG_LEVEL=$(DmsIteratorDebugLevel);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>$(DmsDebugRuntimeLibrary)</RuntimeLibrary>
      <Optimization>Disabled</Optimization>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
    </ClCompile>
    <Midl>
      <PreprocessorDefinitions>_DEBUG;_ITERATOR_DEBUG_LEVEL=$(DmsIteratorDebugLevel);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </Midl>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <ResourceCompile>
      <PreprocessorDefinitions>_DEBUG;_ITERATOR_DEBUG_LEVEL=$(DmsIteratorDebugLevel);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
</Project>
