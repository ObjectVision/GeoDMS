//////////////////////////////////////////////////////////////////////////////
// Self-contained example of a user-defined function (GeoDms >= 20.9.0).
//
// A function is declared with a typed parameter list, a '->' result
// specification, and a result expression after ':='. Its body sees:
//   - its parameters,
//   - its own local items,
//   - namespaces it explicitly imports with a 'using =' clause,
//   - the lexical scope of its DEFINITION (as any expression written there),
//   - the auto-imported standard prelude.
// It does NOT see the scope of the call site: the only channels from the
// caller are the argument expressions, resolved in the caller's scope. This
// makes a function a reusable, checkable unit of calculation.
//
// Run headless with:
//   GeoDmsRun.exe C:\...\examples\function.dms /checks
//////////////////////////////////////////////////////////////////////////////

container function_example
{
	// ------------------------------------------------------------------ data

	unit<uint32> Road : nrofrows = 4
	{
		attribute<float64> flow     : [ 100.0, 200.0,  50.0, 400.0 ];
		attribute<float64> capacity : [ 200.0, 100.0, 100.0, 300.0 ];
	}

	// -------------------------------------------------- function definition
	//
	// CongestionRatio takes a domain unit with the two attributes it needs
	// (a structured, table-typed parameter) and yields the flow/capacity
	// ratio, capped at 1. The body computes an intermediate ('raw'); the
	// result expression after ':=' designates which item is the result.

	function CongestionRatio<V: numerics>(
		unit<uint32> Network {
			attribute<V> flow;
			attribute<V> capacity;
		}
	)
	-> attribute<float64> (Network) := result
	{
		attribute<float64> raw    (Network) := float64(Network/flow) / float64(Network/capacity);
		attribute<float64> result (Network) := min_elem(raw, 1.0);
	}

	// ----------------------------------------------------- application forms (§5.9)
	//
	// A bare function call is its RESULT value; use 'instantiate' to materialize the
	// whole computation (all intermediate steps) as browsable sub-items.

	container          morning       := instantiate CongestionRatio(Road);  // all steps as items
	attribute<float64> evening (Road) := 2.0 * CongestionRatio(Road);        // just the result value

	attribute<float64> congestion (Road) := morning/result;                 // the instantiated result

	// The same function can be applied to any other table that provides the
	// declared attributes; each instantiation is independent.

	unit<uint32> Rail : nrofrows = 2
	{
		attribute<float64> flow     : [ 30.0, 90.0 ];
		attribute<float64> capacity : [ 60.0, 45.0 ];
	}

	container rail_load := instantiate CongestionRatio(Rail);

	// -------------------------------------------------- container literal (§5.9)
	//
	// The structured argument can also be built inline as a container literal —
	// 'domain { member: value; … }' — without a named unit. Inside the literal, '.'
	// refers to the literal's own domain unit. Here a 5-segment road is built on the
	// fly with flow = 100·index and a constant capacity of 200.

	unit<uint32> segment : nrofrows = 5;
	attribute<float64> inline_load (segment) :=
		CongestionRatio( segment { flow: 100.0 * float64(id(.)); capacity: 200.0; } );

	// -------------------------------------------- templates in value position (§5.9)
	//
	// An existing template with a 'result' sub-item can be applied as a value too:
	// 'apply T(args)' binds the arguments to T's leading sub-items and yields its
	// 'result' — the adoption path for template libraries, without migration.

	template CongestionRatioT
	{
		unit<uint32>       Net;
		attribute<float64> flow     (Net);
		attribute<float64> capacity (Net);
		attribute<float64> result   (Net) := min_elem(flow / capacity, 1.0);
	}

	attribute<float64> evening2 (Road) := apply CongestionRatioT(Road, Road/flow, Road/capacity);

	// ------------------------------------------------ a named composite type
	//
	// Any inert item can serve as a named type (type-by-example): 'network'
	// describes a domain of links carrying a flow and a capacity. A parameter
	// declared 'nw: network' accepts any table that provides those members —
	// no need to repeat an inline member block at every function.

	unit<uint32> network
	{
		attribute<float64> flow;
		attribute<float64> capacity;
	}

	function TotalLoad(nw: network)
	-> parameter<float64> := sum(min_elem(nw/flow / nw/capacity, 1.0));

	parameter<float64> road_total := TotalLoad(Road);   // 0.5+1+0.5+1   = 3.0
	parameter<float64> rail_total := TotalLoad(Rail);   // 0.5+1         = 1.5

	// ------------------------------------------ function composition (higher order)
	//
	// compose takes two unary functions as VALUES and applies g after f: g(f(x)).
	// pow4 = sqr-after-sqr, with sqr taken from the auto-imported standard prelude;
	// its reduced key is mul(mul(x,x), mul(x,x)) — identical to pow(x, 4).

	container hof
	{
		function compose<V: numerics>(f: function; g: function; attribute<V> x)
		-> attribute<V> := g(f(x));

		// 'compose' is visible from pow4's definition point (lexical scope, §4.6)
		function pow4<V: numerics>(attribute<V> x)
		-> attribute<V> := compose(sqr, sqr, x);
	}
	// WP3.2 Stage 2 (typed form): a generic function-signature alias types the
	// function-valued parameters and result; D is a domain variable, bound from the
	// argument's domain and checked for consistency at each application. The nested
	// 'result' closes over f and g (captured by value); a call result is applied
	// with a further '(args)' suffix.
	container hof2
	{
		nuf_type = function<V: numerics, D: domains>(attribute<V> (D)) -> attribute<V> (D);  // nuf_type

		function compose<V: numerics, D: domains>(f: nuf_type<V, D>; g: nuf_type<V, D>)
		-> nuf_type<V, D>
		{
			function result(attribute<V> x (D)) -> attribute<V> (D) := f(g(x));
		}

		function pow4<V: numerics, D: domains>(attribute<V> x (D))
		-> attribute<V> (D) := compose(sqr, sqr)(x);
	}
	// §5.11 anonymous functions: the declared item IS the function ('value := function ...'),
	// and a function-typed result may be an anonymous function — no 'result' magic name.
	container hof3
	{
		nuf_type = function<V: numerics, D: domains>(attribute<V> (D)) -> attribute<V> (D);

		twice := function<V: numerics, D: domains>(attribute<V> x (D)) -> attribute<V> (D) := x + x;

		function compose<V: numerics, D: domains>(f: nuf_type<V, D>; g: nuf_type<V, D>)
		-> nuf_type<V, D>
			:= function(attribute<V> x (D)) -> attribute<V> (D) := f(g(x));
	}

	attribute<float64> flow4c (Road) := hof2/pow4(Road/flow);
	attribute<float64> flow4d (Road) := hof2/compose(sqr, sqr)(Road/flow); // applied directly
	attribute<float64> flow4e (Road) := hof3/compose(sqr, sqr)(Road/flow); // anonymous result form
	attribute<float64> flow2  (Road) := hof3/twice(Road/flow);             // anonymous whole-rule form
	// §5.11 tier B: a function literal as an ARGUMENT (lifted at parse time)
	attribute<float64> flow2b (Road)
		:= hof3/compose(function<V: numerics, D: domains>(attribute<V> x (D)) -> attribute<V> (D) := x + x,
		                function<V: numerics, D: domains>(attribute<V> x (D)) -> attribute<V> (D) := x / 2.0)(Road/flow);
	// compose: f(g(x)) = twice(half(x)) = x -> identity

	attribute<float64> flow4  (Road) := hof/pow4(Road/flow);
	attribute<float64> flow4b (Road) := hof/compose(sqr, sqr, Road/flow); // same, spelled directly

	// ------------------------------------------------------------- checks
	//
	// congestion         = min_elem([0.5, 2.0, 0.5, 4/3], 1) = [0.5, 1, 0.5, 1]
	// rail_load/result   = min_elem([0.5, 2.0        ], 1) = [0.5, 1]
	// inline_load        = min_elem([0, .5, 1, 1.5, 2  ], 1) = [0, .5, 1, 1, 1]
	// evening2           = congestion
	// flow4              = flow^4 = [1e8, 1.6e9, 6.25e6, 2.56e10]; sum = 27306250000

	container checks
	{
		parameter<float64> road_sum   := sum(congestion),        IntegrityCheck = "road_sum == 3.0";
		parameter<float64> rail_sum   := sum(rail_load/result),  IntegrityCheck = "rail_sum == 1.5";
		parameter<float64> inline_sum := sum(inline_load),       IntegrityCheck = "inline_sum == 3.5";
		parameter<float64> road_sum2  := sum(evening2),          IntegrityCheck = "road_sum2 == 3.0";
		parameter<float64> pow4_sum   := sum(flow4),             IntegrityCheck = "pow4_sum == 27306250000.0";
		parameter<float64> pow4_sumb  := sum(flow4b),            IntegrityCheck = "pow4_sumb == 27306250000.0";
		parameter<float64> road_tot   := road_total,             IntegrityCheck = "road_tot == 3.0";
		parameter<float64> rail_tot   := rail_total,             IntegrityCheck = "rail_tot == 1.5";
		parameter<float64> pow4_sumc  := sum(flow4c),            IntegrityCheck = "pow4_sumc == 27306250000.0";
		parameter<float64> pow4_sumd  := sum(flow4d),            IntegrityCheck = "pow4_sumd == 27306250000.0";
		parameter<float64> pow4_sume  := sum(flow4e),            IntegrityCheck = "pow4_sume == 27306250000.0";
		parameter<float64> twice_sum  := sum(flow2),             IntegrityCheck = "twice_sum == 1500.0";
		parameter<float64> ident_sum  := sum(flow2b),            IntegrityCheck = "ident_sum == 750.0";
	}
}
