<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{12acde31-1e1f-4e8a-af9d-410cb09aa101}</ProjectGuid>
    <RootNamespace>CopyResources</RootNamespace>
    <Keyword>GeoDms files</Keyword>
    <MinimumVisualStudioVersion>15.0</MinimumVisualStudioVersion>
    <ApplicationTypeRevision>1.0</ApplicationTypeRevision>
    <TargetLinuxPlatform>Generic</TargetLinuxPlatform>
    <LinuxProjectType>{FC1A4D80-50E9-41DA-9192-61C0DBAA00D2}</LinuxProjectType>
    <ProjectName>CopyResources</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <ImportGroup Condition="'$(Configuration)'=='Release'" Label="PropertySheets">
    <Import Project="$(SolutionDir)DmsRelease.props" />
  </ImportGroup>
  <ImportGroup Condition="'$(Configuration)'=='Debug'" Label="PropertySheets">
    <Import Project="$(SolutionDir)DmsDebug.props" />
  </ImportGroup>
  <!-- vcpkg runtime-DLL source per config: the app needs the whole gdal/geos/proj/netcdf/
       tinyxml2/... stack at runtime, and vcpkg's applocal does not reliably repopulate them
       into $(OutDir) on incremental builds. Copy them here so bin\<cfg>\x64 is always complete
       (and the NSIS installers find them). VcpkgInstalledDir/VcpkgTriplet come from DmsDef.props. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <_VcpkgRuntimeBin>$(VcpkgInstalledDir)$(VcpkgTriplet)\bin</_VcpkgRuntimeBin>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <_VcpkgRuntimeBin>$(VcpkgInstalledDir)$(VcpkgTriplet)\debug\bin</_VcpkgRuntimeBin>
  </PropertyGroup>
  <PropertyGroup>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <NMakeBuildCommandLine>
echo copying files to $(OutDir)
robocopy "$(SolutionDir)library" "$(OutDir)library" /E /NJH /NJS /NP /R:2 /W:2 /XO
if errorlevel 8 ( echo *** CopyResources: robocopy library FAILED *** &amp; exit /b 1 )
robocopy "$(SolutionDir)examples" "$(OutDir)examples" /E /NJH /NJS /NP /R:2 /W:2 /XO
if errorlevel 8 ( echo *** CopyResources: robocopy examples FAILED *** &amp; exit /b 1 )
robocopy "$(SolutionDir)testcases" "$(OutDir)examples\testcases" /E /NJH /NJS /NP /R:2 /W:2 /XO /XD _out*
if errorlevel 8 ( echo *** CopyResources: robocopy testcases FAILED *** &amp; exit /b 1 )
if not exist "$(_VcpkgRuntimeBin)\*.dll" ( echo *** CopyResources: vcpkg runtime bin not found or empty - "$(_VcpkgRuntimeBin)" *** &amp; exit /b 1 )
robocopy "$(_VcpkgRuntimeBin)" "$(OutDir.TrimEnd('\'))" *.dll /NJH /NJS /NP /R:2 /W:2 /XO
if errorlevel 8 ( echo *** CopyResources: robocopy vcpkg runtime DLLs FAILED *** &amp; exit /b 1 )
exit /b 0
    </NMakeBuildCommandLine>
    <CopyCppRuntimeToOutputDir>false</CopyCppRuntimeToOutputDir>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>