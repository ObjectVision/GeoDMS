<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{12acde31-1e1f-4e8a-af9d-410cb09aa101}</ProjectGuid>
    <RootNamespace>CopyResources</RootNamespace>
    <Keyword>GeoDms files</Keyword>
    <MinimumVisualStudioVersion>15.0</MinimumVisualStudioVersion>
    <ApplicationTypeRevision>1.0</ApplicationTypeRevision>
    <TargetLinuxPlatform>Generic</TargetLinuxPlatform>
    <LinuxProjectType>{FC1A4D80-50E9-41DA-9192-61C0DBAA00D2}</LinuxProjectType>
    <ProjectName>CopyResources</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <ImportGroup Condition="'$(Configuration)'=='Release'" Label="PropertySheets">
    <Import Project="$(SolutionDir)DmsRelease.props" />
  </ImportGroup>
  <ImportGroup Condition="'$(Configuration)'=='Debug'" Label="PropertySheets">
    <Import Project="$(SolutionDir)DmsDebug.props" />
  </ImportGroup>
  <!-- vcpkg runtime-DLL source per config: the app needs the whole gdal/geos/proj/netcdf/
       tinyxml2/... stack at runtime, and vcpkg's applocal does not reliably repopulate them
       into $(OutDir) on incremental builds. Copy them here so bin\<cfg>\x64 is always complete
       (and the NSIS installers find them). VcpkgInstalledDir/VcpkgTriplet come from DmsDef.props. -->
  <PropertyGroup>
    <_VcpkgRuntimeBin>$(VcpkgInstalledDir)$(VcpkgTriplet)\bin</_VcpkgRuntimeBin>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug' and '$(GeoDmsGlobio)' != 'true'">
    <_VcpkgRuntimeBin>$(VcpkgInstalledDir)$(VcpkgTriplet)\debug\bin</_VcpkgRuntimeBin>
  </PropertyGroup>
  <!-- The three resource trees are MIRRORED, not merely topped up: /PURGE deletes files and
       folders that no longer exist in the source. Without it robocopy only ever adds, so a
       .dms file deleted from (or never committed to) the source tree kept a copy in
       bin\<cfg>\x64 forever - and batch\TestShippedContent.bat, the issue #1031 release test,
       runs the SHIPPED examples\testcases battery from there. Three uncommitted drafts left
       behind on 2026-09-05 made it exit 1 on 2026-09-07 while the engine was green.

       Two exclusions carry the whole design, and /XD keeps a directory out of the purge as
       well as out of the copy (an excluded folder is never reported EXTRA):

       * testcases is copied INTO $(OutDir)examples\testcases, but the source examples\ has no
         testcases subfolder - so without /XD the examples mirror would see the entire battery
         as extra and delete it, _out and all, on every build.
       * _out* are the battery's own run artifacts, written next to the shipped configs by
         run_testcases.ps1. They exist only in the output and must survive.

       /PURGE reports the extras it removes, which sets robocopy's exit bit 2; the guards below
       test errorlevel 8 (copy failures) and are unaffected. The vcpkg DLL copy further down
       must NEVER get /PURGE: its destination is $(OutDir) itself, so mirroring it would delete
       every binary the build just produced. -->
  <PropertyGroup>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <NMakeBuildCommandLine>
echo copying files to $(OutDir)
robocopy "$(SolutionDir)library" "$(OutDir)library" /E /PURGE /NJH /NJS /NP /R:2 /W:2 /XO
if errorlevel 8 ( echo *** CopyResources: robocopy library FAILED *** &amp; exit /b 1 )
robocopy "$(SolutionDir)examples" "$(OutDir)examples" /E /PURGE /NJH /NJS /NP /R:2 /W:2 /XO /XD "$(OutDir)examples\testcases"
if errorlevel 8 ( echo *** CopyResources: robocopy examples FAILED *** &amp; exit /b 1 )
robocopy "$(SolutionDir)testcases" "$(OutDir)examples\testcases" /E /PURGE /NJH /NJS /NP /R:2 /W:2 /XO /XD _out*
if errorlevel 8 ( echo *** CopyResources: robocopy testcases FAILED *** &amp; exit /b 1 )
if not exist "$(_VcpkgRuntimeBin)\*.dll" ( echo *** CopyResources: vcpkg runtime bin not found or empty - "$(_VcpkgRuntimeBin)" *** &amp; exit /b 1 )
robocopy "$(_VcpkgRuntimeBin)" "$(OutDir.TrimEnd('\'))" *.dll /XF python*.dll /NJH /NJS /NP /R:2 /W:2 /XO
if errorlevel 8 ( echo *** CopyResources: robocopy vcpkg runtime DLLs FAILED *** &amp; exit /b 1 )
if "$(GeoDmsGlobio)"=="true" powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$(SolutionDir)tools\deploy-globio-runtime.ps1" -OutputDir "$(OutDir.TrimEnd('\'))" -GlobioRoot "$(GeoDmsGlobioRoot)"
if "$(GeoDmsGlobio)"=="true" if errorlevel 1 ( echo *** CopyResources: GLOBIO runtime deployment FAILED *** &amp; exit /b 1 )
exit /b 0
    </NMakeBuildCommandLine>
    <CopyCppRuntimeToOutputDir>false</CopyCppRuntimeToOutputDir>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
