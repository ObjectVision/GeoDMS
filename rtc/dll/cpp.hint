// Hint files help the Visual Studio IDE interpret Visual C++ identifiers
// such as names of functions and macros.
// For more information see https://go.microsoft.com/fwlink/?linkid=865984
#define IMPL_CLASS(cls, CreateFunc) const Class* cls::GetStaticClass() { static Class s_Cls(CreateFunc, cls::base_type::GetStaticClass(), GetTokenID_st(#cls) ); return &s_Cls; }
// The export macros are all dllexport inside the merged DmRtc (DMRTC_EXPORTS,
// DMSYM_EXPORTS and DMTIC_EXPORTS are all defined); for parsing hints an empty
// expansion suffices.
#define RTC_CALL
#define SYM_CALL
#define TIC_CALL
#define TICTOC_CALL
